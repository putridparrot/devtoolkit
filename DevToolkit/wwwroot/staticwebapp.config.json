{
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/css/*",
      "/js/*",
      "/images/*",
      "/icon-*.png",
      "/favicon.ico",
      "/service-worker*.js",
      "/manifest.webmanifest"
    ]
  }
}
