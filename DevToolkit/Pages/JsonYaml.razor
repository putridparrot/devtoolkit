@page "/json-yaml"
@attribute [ToolPage("JSON/YAML", "🔁", "Convert JSON and YAML plus validate JSON against a schema.", 16)]
@inject ToolStateStore Store
@using DevToolkit.Infrastructure
@using DevToolkit.Services
@using System.Collections
@using System.Globalization
@using System.Linq
@using System.Threading
@using System.Text.Json
@using NJsonSchema
@using YamlDotNet.Serialization
@inject ISettingsService SettingsService
@implements IDisposable

<PageTitle>JSON &amp; YAML</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px;">
    <FluentLabel Typo="Typography.PageTitle">JSON &amp; YAML Utilities</FluentLabel>
    
    <FluentCard Style="padding: 20px;">

    <FluentTabs Style="width: 100%;">
        <FluentTab Label="Convert">
            <FluentStack Orientation="Orientation.Vertical" Style="gap: 20px; padding: 20px; width: 100%;">
                <div class="convert-grid">
                    <FluentCard Class="convert-card" Style="padding: 16px; width: 100%;">
                        <FluentLabel Typo="Typography.Subject">JSON</FluentLabel>
                        <FluentTextArea Value="@State.JsonInput"
                                        ValueChanged="OnJsonInputChanged"
                                        Rows="14"
                                        Style="width: 100%; margin-top: 10px; font-family: monospace;" />
                    </FluentCard>

                    <FluentCard Class="convert-card" Style="padding: 16px; width: 100%;">
                        <FluentLabel Typo="Typography.Subject">YAML</FluentLabel>
                        <FluentTextArea Value="@State.YamlInput"
                                        ValueChanged="OnYamlInputChanged"
                                        Rows="14"
                                        Style="width: 100%; margin-top: 10px; font-family: monospace;" />
                    </FluentCard>
                </div>

                <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; flex-wrap: wrap;">
                    <FluentButton Appearance="Appearance.Accent" OnClick="ConvertJsonToYaml">JSON to YAML</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" OnClick="ConvertYamlToJson">YAML to JSON</FluentButton>
                    <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearConvertFields">Clear</FluentButton>
                </FluentStack>

                @if (!string.IsNullOrWhiteSpace(State.ConvertMessage))
                {
                    <FluentMessageBar Intent="@State.ConvertIntent">@State.ConvertMessage</FluentMessageBar>
                }
            </FluentStack>
        </FluentTab>

        <FluentTab Label="Schema Validation">
            <FluentStack Orientation="Orientation.Vertical" Style="gap: 20px; padding: 20px; width: 100%;">
                <div class="schema-grid">
                    <FluentCard Class="schema-card" Style="padding: 16px; width: 100%;">
                        <FluentLabel Typo="Typography.Subject">JSON Schema</FluentLabel>
                        <FluentTextArea Value="@State.SchemaInput"
                                        ValueChanged="OnSchemaInputChanged"
                                        Rows="12"
                                        Style="width: 100%; margin-top: 10px; font-family: monospace;" />
                    </FluentCard>

                    <FluentCard Class="schema-card" Style="padding: 16px; width: 100%;">
                        <FluentLabel Typo="Typography.Subject">JSON Data</FluentLabel>
                        <FluentTextArea Value="@State.SchemaDataInput"
                                        ValueChanged="OnSchemaDataInputChanged"
                                        Rows="12"
                                        Style="width: 100%; margin-top: 10px; font-family: monospace;" />
                    </FluentCard>
                </div>

                <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; flex-wrap: wrap;">
                    <FluentButton Appearance="Appearance.Accent" OnClick="ValidateSchemaAsync">Validate</FluentButton>
                    <FluentButton Appearance="Appearance.Lightweight" OnClick="ResetSchemaFields">Reset</FluentButton>
                </FluentStack>

                @if (!string.IsNullOrWhiteSpace(State.SchemaMessage))
                {
                    <FluentMessageBar Intent="@State.SchemaIntent">@State.SchemaMessage</FluentMessageBar>
                }

                @if (State.SchemaIssues.Count > 0)
                {
                    <FluentCard Style="padding: 16px;">
                        <FluentLabel Typo="Typography.Subject">Validation Issues</FluentLabel>
                        <FluentDataGrid Items="@State.SchemaIssues.AsQueryable()" GridTemplateColumns="200px 1fr" Style="margin-top: 10px;">
                            <PropertyColumn Property="@(issue => issue.Path)" Title="Path" />
                            <PropertyColumn Property="@(issue => issue.Message)" Title="Message" />
                        </FluentDataGrid>
                    </FluentCard>
                }
            </FluentStack>
        </FluentTab>
    </FluentTabs>
    </FluentCard>
</FluentStack>
</div>

@code {
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out _isNewState);
    }

    private readonly ISerializer _yamlSerializer = new SerializerBuilder()
        .WithIndentedSequences()
        .Build();
    private readonly IDeserializer _yamlDeserializer = new DeserializerBuilder().Build();


        private const string DefaultSchema = @"{
    ""$schema"": ""https://json-schema.org/draft/2020-12/schema"",
    ""type"": ""object"",
    ""properties"": {
        ""name"": { ""type"": ""string"" },
        ""age"": { ""type"": ""integer"", ""minimum"": 0 }
    },
    ""required"": [""name""]
}";

        private const string DefaultSchemaData = @"{
    ""name"": ""Ada"",
    ""age"": 32
}";



    private AppSettings? _settings;
    private bool _settingsLoaded;
    private bool _isNewState;
    private readonly TimeSpan _autosaveDelay = TimeSpan.FromMilliseconds(600);
    private CancellationTokenSource? _autosaveCts;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.LoadSettingsAsync();
        var stored = _settings.JsonYaml ??= new JsonYamlSettings();
        if (_isNewState)
        {
            State.JsonInput = stored.ConvertJsonInput ?? State.JsonInput;
            State.YamlInput = stored.ConvertYamlInput ?? State.YamlInput;
            State.SchemaInput = stored.SchemaInput ?? DefaultSchema;
            State.SchemaDataInput = stored.SchemaDataInput ?? DefaultSchemaData;
        }
        _settingsLoaded = true;
    }

    private async Task ConvertJsonToYaml()
    {
        State.ConvertMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(State.JsonInput))
        {
            State.ConvertIntent = MessageIntent.Info;
            State.ConvertMessage = "Provide JSON to convert.";
            return;
        }

        try
        {
            var element = JsonSerializer.Deserialize<JsonElement>(State.JsonInput);
            var normalized = ConvertJsonElement(element);
            State.YamlInput = _yamlSerializer.Serialize(normalized).TrimEnd();
            State.ConvertIntent = MessageIntent.Success;
            State.ConvertMessage = "Converted JSON to YAML.";
            await PersistAsync();
        }
        catch (Exception ex)
        {
            State.ConvertIntent = MessageIntent.Error;
            State.ConvertMessage = $"JSON conversion failed: {ex.Message}";
        }
    }

    private async Task ConvertYamlToJson()
    {
        State.ConvertMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(State.YamlInput))
        {
            State.ConvertIntent = MessageIntent.Info;
            State.ConvertMessage = "Provide YAML to convert.";
            return;
        }

        try
        {
            var yamlObject = _yamlDeserializer.Deserialize<object?>(State.YamlInput);
            var normalized = NormalizeYamlObject(yamlObject);
            State.JsonInput = JsonSerializer.Serialize(normalized, new JsonSerializerOptions { WriteIndented = true });
            State.ConvertIntent = MessageIntent.Success;
            State.ConvertMessage = "Converted YAML to JSON.";
            await PersistAsync();
        }
        catch (Exception ex)
        {
            State.ConvertIntent = MessageIntent.Error;
            State.ConvertMessage = $"YAML conversion failed: {ex.Message}";
        }
    }

    private async Task ClearConvertFields()
    {
        State.JsonInput = string.Empty;
        State.YamlInput = string.Empty;
        State.ConvertMessage = string.Empty;
        await PersistAsync();
    }

    private async Task ValidateSchemaAsync()
    {
        State.SchemaIssues.Clear();
        State.SchemaMessage = string.Empty;

        try
        {
            var schema = await JsonSchema.FromJsonAsync(State.SchemaInput);
            var errors = schema.Validate(State.SchemaDataInput);

            if (errors.Count == 0)
            {
                State.SchemaIntent = MessageIntent.Success;
                State.SchemaMessage = "JSON satisfies the schema.";
            }
            else
            {
                State.SchemaIntent = MessageIntent.Error;
                State.SchemaMessage = $"Found {errors.Count} validation issue(s).";

                foreach (var error in errors)
                {
                    var path = string.IsNullOrWhiteSpace(error.Path) ? "$" : error.Path!;
                    var description = string.IsNullOrWhiteSpace(error.ToString()) ? error.Kind.ToString() : error.ToString();
                    State.SchemaIssues.Add(new SchemaValidationIssue(path, description));
                }
            }
        }
        catch (Exception ex)
        {
            State.SchemaIntent = MessageIntent.Error;
            State.SchemaMessage = $"Validation failed: {ex.Message}";
        }
    }

    private async Task ResetSchemaFields()
    {
                State.SchemaInput = DefaultSchema;
                State.SchemaDataInput = DefaultSchemaData;
        State.SchemaMessage = string.Empty;
        State.SchemaIssues.Clear();
        await PersistAsync();
    }

    private void OnJsonInputChanged(string value)
    {
        State.JsonInput = value;
        ScheduleAutoSave();
    }

    private void OnYamlInputChanged(string value)
    {
        State.YamlInput = value;
        ScheduleAutoSave();
    }

    private void OnSchemaInputChanged(string value)
    {
        State.SchemaInput = value;
        ScheduleAutoSave();
    }

    private void OnSchemaDataInputChanged(string value)
    {
        State.SchemaDataInput = value;
        ScheduleAutoSave();
    }

    private void ScheduleAutoSave()
    {
        if (!_settingsLoaded)
        {
            return;
        }

        _autosaveCts?.Cancel();
        var cts = new CancellationTokenSource();
        _autosaveCts = cts;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(_autosaveDelay, cts.Token);
                await InvokeAsync(PersistAsync);
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

    private async Task PersistAsync()
    {
        if (_settings is null)
        {
            return;
        }

        var stored = _settings.JsonYaml ??= new JsonYamlSettings();
        stored.ConvertJsonInput = State.JsonInput;
        stored.ConvertYamlInput = State.YamlInput;
        stored.SchemaInput = State.SchemaInput;
        stored.SchemaDataInput = State.SchemaDataInput;
        stored.LastUpdated = DateTimeOffset.UtcNow;

        await SettingsService.SaveSettingsAsync(_settings);
    }

    private static object? ConvertJsonElement(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.Object => element
                .EnumerateObject()
                .ToDictionary(property => property.Name, property => ConvertJsonElement(property.Value)),
            JsonValueKind.Array => element
                .EnumerateArray()
                .Select(ConvertJsonElement)
                .ToList(),
            JsonValueKind.String => element.GetString(),
            JsonValueKind.Number => element.TryGetInt64(out var l) ? l : element.GetDouble(),
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            JsonValueKind.Null => null,
            _ => null
        };
    }

    private static object? NormalizeYamlObject(object? value)
    {
        switch (value)
        {
            case IDictionary dictionary:
                var normalizedDict = new Dictionary<string, object?>(StringComparer.Ordinal);
                foreach (DictionaryEntry entry in dictionary)
                {
                    var key = Convert.ToString(entry.Key, CultureInfo.InvariantCulture) ?? string.Empty;
                    normalizedDict[key] = NormalizeYamlObject(entry.Value);
                }
                return normalizedDict;
            case IEnumerable enumerable when value is not string:
                var list = new List<object?>();
                foreach (var item in enumerable)
                {
                    list.Add(NormalizeYamlObject(item));
                }
                return list;
            default:
                return value;
        }
    }

    private sealed record SchemaValidationIssue(string Path, string Message);

    public void Dispose()
    {
        _autosaveCts?.Cancel();
    }

    private sealed class PageState
    {
        public string JsonInput = "{\n  \"name\": \"Ada\",\n  \"skills\": [\"http\", \"yaml\"],\n  \"active\": true\n}";
        public string YamlInput = "name: Ada\nskills:\n  - http\n  - yaml\nactive: true";
        public string ConvertMessage = string.Empty;
        public MessageIntent ConvertIntent = MessageIntent.Info;
        public string SchemaInput = DefaultSchema;
        public string SchemaDataInput = DefaultSchemaData;
        public string SchemaMessage = string.Empty;
        public MessageIntent SchemaIntent = MessageIntent.Info;
        public readonly List<SchemaValidationIssue> SchemaIssues = new();
    }
}
