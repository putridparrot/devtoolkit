@page "/jwt"
@attribute [ToolPage("JWT", "🔐", "Decode and inspect JWT tokens easily.", 2)]
@inject ToolStateStore Store
@using System.Text.Json
@using DevToolkit.Infrastructure
@using DevToolkit.Services

<PageTitle>JWT</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px;">
    <FluentLabel Typo="Typography.PageTitle">JWT Tools</FluentLabel>

    <FluentCard Style="padding: 20px; overflow: visible;">
        <FluentTabs Style="overflow: visible;">
            <FluentTab Label="Decode">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 20px; padding: 20px;">
                    <FluentCard Style="padding: 20px;">
                        <FluentLabel Typo="Typography.Subject">Paste JWT Token</FluentLabel>
                        <FluentTextArea Value="@State.JwtToken" ValueChanged="@((string val) => State.JwtToken = val)" Placeholder="Paste your JWT token here..." Rows="5" Style="width: 100%; margin-top: 10px;" />
                        <FluentButton Appearance="Appearance.Accent" OnClick="DecodeToken" Style="margin-top: 10px;">Decode JWT</FluentButton>
                    </FluentCard>

                    @if (State.DecodedResult is not null && State.DecodedResult.Parts.Count > 0)
                    {
                        @foreach (var part in State.DecodedResult.Parts)
                        {
                            <FluentCard Style="padding: 20px;">
                                <FluentLabel Typo="Typography.Subject">@part.Name</FluentLabel>

                                <FluentStack Orientation="Orientation.Vertical" Style="gap: 10px; margin-top: 10px;">
                                    <FluentLabel>Raw</FluentLabel>
                                    <FluentTextArea Value="@part.Raw" ReadOnly="true" Rows="2" Style="width: 100%; font-family: monospace;" />

                                    <FluentLabel>Decoded</FluentLabel>
                                    <FluentTextArea Value="@(part.CanDecode ? part.Decoded : "Not decodable as Base64Url UTF-8 text")" ReadOnly="true" Rows="8" Style="width: 100%; font-family: monospace;" />
                                </FluentStack>
                            </FluentCard>
                        }

                        @if (State.DecodedResult.Claims.Count > 0)
                        {
                            <FluentCard Style="padding: 20px;">
                                <FluentLabel Typo="Typography.Subject">Claims</FluentLabel>
                                <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px; margin-top: 10px;">
                                    @foreach (var claim in State.DecodedResult.Claims)
                                    {
                                        <FluentLabel><strong>@claim.Key</strong>: @claim.Value</FluentLabel>
                                    }
                                </FluentStack>
                            </FluentCard>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(State.DecodeErrorMessage))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error">
                            @State.DecodeErrorMessage
                        </FluentMessageBar>
                    }
                </FluentStack>
            </FluentTab>

            <FluentTab Label="Encode">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 15px; padding: 20px;">
                    <FluentLabel Typo="Typography.Subject">Header (JSON)</FluentLabel>
                    <FluentTextArea Value="@State.EncodeHeaderJson" ValueChanged="@((string val) => State.EncodeHeaderJson = val)" Rows="6" Style="width: 100%; font-family: monospace;" />

                    <FluentLabel Typo="Typography.Subject">Payload (JSON)</FluentLabel>
                    <FluentTextArea Value="@State.EncodePayloadJson" ValueChanged="@((string val) => State.EncodePayloadJson = val)" Rows="8" Style="width: 100%; font-family: monospace;" />

                    <FluentLabel Typo="Typography.Subject">Secret (optional)</FluentLabel>
                    <FluentTextField Value="@State.EncodeSecret" ValueChanged="@((string val) => State.EncodeSecret = val)" Placeholder="Leave empty for unsigned token" Style="width: 100%;" />

                    <FluentButton Appearance="Appearance.Accent" OnClick="EncodeToken">Create JWT</FluentButton>

                    @if (!string.IsNullOrWhiteSpace(State.EncodeErrorMessage))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error">
                            @State.EncodeErrorMessage
                        </FluentMessageBar>
                    }

                    <FluentCard Style="padding: 20px;">
                        <FluentLabel Typo="Typography.Subject">JWT Editor</FluentLabel>
                        <FluentTextArea Class="jwt-editor"
                                        Value="@State.GeneratedToken"
                                        ValueChanged="@((string val) => State.GeneratedToken = val)"
                                        Placeholder="Generated token will appear here after clicking Create JWT"
                                        Rows="6"
                                        Style="width: 100%; margin-top: 10px; font-family: monospace;" />
                    </FluentCard>
                </FluentStack>
            </FluentTab>
        </FluentTabs>
    </FluentCard>
</FluentStack>
</div>

@code {
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out _);
    }

    private readonly JwtTokenCodec _codec = new();

    private void DecodeToken()
    {
        State.DecodeErrorMessage = string.Empty;
        State.DecodedResult = null;

        try
        {
            var parts = State.JwtToken.Trim().Split('.', StringSplitOptions.None);
            if (parts.Length < 2)
            {
                State.DecodeErrorMessage = "Invalid token format. Expected at least 2 parts separated by dots.";
                return;
            }

            State.DecodedResult = _codec.Decode(State.JwtToken);
        }
        catch (Exception ex)
        {
            State.DecodeErrorMessage = $"Error decoding JWT: {ex.Message}";
        }
    }

    private void EncodeToken()
    {
        State.EncodeErrorMessage = string.Empty;
        State.GeneratedToken = string.Empty;

        try
        {
            var header = ParseJsonObject(State.EncodeHeaderJson, "Header");
            var payload = ParseJsonObject(State.EncodePayloadJson, "Payload");

            State.GeneratedToken = string.IsNullOrWhiteSpace(State.EncodeSecret)
                ? _codec.Encode(header, payload)
                : _codec.EncodeHs256(header, payload, State.EncodeSecret);
        }
        catch (Exception ex)
        {
            State.EncodeErrorMessage = $"Error creating JWT: {ex.Message}";
        }
    }

    private static Dictionary<string, object?> ParseJsonObject(string json, string sectionName)
    {
        using var document = JsonDocument.Parse(json);
        if (document.RootElement.ValueKind != JsonValueKind.Object)
            throw new InvalidOperationException($"{sectionName} JSON must be an object.");

        return JsonSerializer.Deserialize<Dictionary<string, object?>>(json)
            ?? throw new InvalidOperationException($"{sectionName} JSON is empty.");
    }


    private sealed class PageState
    {
        public string JwtToken = string.Empty;
        public string DecodeErrorMessage = string.Empty;
        public JwtDecodeResult? DecodedResult;
        public string EncodeHeaderJson = "{\n  \"alg\": \"HS256\",\n  \"typ\": \"JWT\"\n}";
        public string EncodePayloadJson = "{\n  \"sub\": \"1234567890\",\n  \"name\": \"John Doe\",\n  \"iat\": 1516239022\n}";
        public string EncodeSecret = string.Empty;
        public string EncodeErrorMessage = string.Empty;
        public string GeneratedToken = string.Empty;
    }
}
