@page "/har"
@attribute [ToolPage("HAR", "📊", "Inspect, sanitize, and replay HTTP Archive (HAR) captures.", 3)]
@using System.Linq
@using System.Text
@using System.Text.Json
@using DevToolkit.Infrastructure
@using DevToolkit.Services
@using DevToolkit.Services.Har
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject ToolStateStore Store

<PageTitle>HAR Replay &amp; Sanitizer</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px; height: 100%;">
    <FluentLabel Typo="Typography.PageTitle">HAR Replay &amp; Sanitizer</FluentLabel>
    
    <FluentCard Style="padding: 20px;">
        <FluentLabel Typo="Typography.Subject">Load HAR content</FluentLabel>
        <div class="har-load-row">
            <InputFile OnChange="LoadHarFile" accept=".har,.hat,application/json" disabled="@_isBusy" />
        </div>
        <textarea class="har-input"
                  @bind="State.HarContent"
                  @bind:event="onchange"
                  disabled="@_isBusy"
                  placeholder="Paste your HAR file content here..."></textarea>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px; margin-top: 10px;">
            <FluentButton Appearance="Appearance.Accent" OnClick="ParseHar" Disabled="@_isBusy">Parse HAR</FluentButton>
            @if (_isBusy)
            {
                <FluentProgressRing Width="24px" />
                <FluentLabel Typo="Typography.Body">@_busyMessage</FluentLabel>
            }
        </FluentStack>
    </FluentCard>

    @if (State.Entries.Any() && !_isBusy)
    {
        <FluentCard Style="padding: 20px;">
            <FluentLabel Typo="Typography.Subject" Class="har-section-label">Filter &amp; sanitize</FluentLabel>
            <div class="har-controls-grid">
                <div>
                    <label>Search</label>
                    <FluentTextField Value="@State.FilterText" ValueChanged="@((string value) => OnFilterTextChanged(value))" Placeholder="URL, header, host..." />
                </div>
                <div>
                    <label>Method</label>
                    <FluentCombobox Items="@State.MethodOptions"
                                    SelectedOption="@State.MethodFilter"
                                    SelectedOptionChanged="@((string? value) => OnMethodFilterChanged(value))"
                                    Style="min-width: 130px;"
                                    Class="readonly-combo">
                        <OptionTemplate>@context</OptionTemplate>
                    </FluentCombobox>
                </div>
                <div>
                    <label>Status</label>
                    <FluentCombobox Items="@_statusOptions"
                                    SelectedOption="@State.StatusFilter"
                                    SelectedOptionChanged="@((string? value) => OnStatusFilterChanged(value))"
                                    Style="min-width: 130px;"
                                    Class="readonly-combo">
                        <OptionTemplate>@context</OptionTemplate>
                    </FluentCombobox>
                </div>
                <FluentCheckbox Value="@State.OnlyErrors" ValueChanged="@((bool value) => OnOnlyErrorsChanged(value))">Only errors</FluentCheckbox>
                <FluentCheckbox Value="@State.HideNoise"
                                ValueChanged="@((bool value) => OnHideNoiseChanged(value))"
                                Title="Hides successful static assets, telemetry, cached responses and CORS preflights. Failed requests are always shown.">
                    Hide noise (@State.NoiseCount)
                </FluentCheckbox>
            </div>

            <FluentDivider Style="margin: 16px 0;" />

            <FluentLabel Typo="Typography.Body" Class="har-section-label">Sanitizer options</FluentLabel>
            <div class="har-sanitizer-grid">
                <FluentCheckbox Value="@State.StripQuery" ValueChanged="@((bool value) => ToggleStripQuery(value))">Strip query string</FluentCheckbox>
                <FluentCheckbox Value="@State.RedactAuth" ValueChanged="@((bool value) => ToggleRedactAuth(value))">Redact Authorization</FluentCheckbox>
                <FluentCheckbox Value="@State.RedactCookies" ValueChanged="@((bool value) => ToggleRedactCookies(value))">Redact cookies</FluentCheckbox>
                <FluentCheckbox Value="@State.RedactBodies" ValueChanged="@((bool value) => ToggleRedactBodies(value))">Redact bodies</FluentCheckbox>
            </div>

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; margin-top: 12px; flex-wrap: wrap;">
                <FluentButton Appearance="Appearance.Accent" OnClick="CopySanitizedHar">Copy sanitized HAR</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="CopyVisibleCurl" Disabled="@string.IsNullOrEmpty(State.CurlPreview)">Copy selected cURL</FluentButton>
            </FluentStack>
        </FluentCard>

        <FluentCard Style="padding: 20px;">
            <FluentLabel Typo="Typography.Subject">Summary</FluentLabel>
            <div class="har-summary-grid">
                <div>
                    <span class="summary-label">Total requests</span>
                    <span class="summary-value">@State.Entries.Count</span>
                </div>
                <div>
                    <span class="summary-label">Filtered view</span>
                    <span class="summary-value">@State.FilteredEntries.Count</span>
                </div>
                <div>
                    <span class="summary-label">Hosts</span>
                    <span class="summary-value">@State.Entries.Select(e => e.Host).Distinct().Count()</span>
                </div>
                <div>
                    <span class="summary-label">Total time</span>
                    <span class="summary-value">@State.Entries.Sum(e => e.Time) ms</span>
                </div>
                <div>
                    <span class="summary-label">2xx</span>
                    <span class="summary-value">@State.Entries.Count(e => e.Status is >= 200 and < 300)</span>
                </div>
                <div>
                    <span class="summary-label">4xx/5xx</span>
                    <span class="summary-value">@State.Entries.Count(e => e.Status >= 400)</span>
                </div>
                <div>
                    <span class="summary-label">No response</span>
                    <span class="summary-value">@State.Entries.Count(e => e.Status == 0)</span>
                </div>
            </div>
        </FluentCard>

        <FluentCard Style="padding: 20px;">
            <FluentLabel Typo="Typography.Subject">Insights (@State.Findings.Count)</FluentLabel>
            <FluentLabel Style="font-size: 0.85rem; opacity: 0.8;">Rule-based hints about likely causes. They point you where to look; they aren't proof.</FluentLabel>
            @if (State.Findings.Count == 0)
            {
                <FluentLabel Typo="Typography.Body" Style="margin-top: 10px;">No issues detected.</FluentLabel>
            }
            <div class="har-findings">
                @foreach (var finding in State.Findings)
                {
                    <div class="har-finding @GetFindingClass(finding.Severity)">
                        <div class="har-finding-title">@GetFindingIcon(finding.Severity) @finding.Title</div>
                        <div class="har-finding-detail">@finding.Detail</div>
                        @if (finding.Evidence.Count > 0)
                        {
                            <div class="har-finding-evidence">
                                @foreach (var entry in finding.Evidence.Take(MaxEvidence))
                                {
                                    <FluentButton Appearance="Appearance.Lightweight"
                                                  OnClick="() => SelectEntry(entry)"
                                                  Title="Inspect this request">
                                        @FormatEvidence(entry)
                                    </FluentButton>
                                }
                                @if (finding.Evidence.Count > MaxEvidence)
                                {
                                    <span class="har-finding-more">and @(finding.Evidence.Count - MaxEvidence) more</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </FluentCard>

        <FluentCard Style="padding: 20px;">
            <FluentLabel Typo="Typography.Subject">HTTP Requests (@State.FilteredEntries.Count)</FluentLabel>
            <FluentDataGrid Items="@State.FilteredEntries.AsQueryable()" Style="margin-top: 10px;" GridTemplateColumns="90px 2fr 100px 100px 120px">
                <PropertyColumn Property="@(e => e.Method)" Title="Method" />
                <PropertyColumn Property="@(e => e.Url)" Title="URL" />
                <TemplateColumn Title="Status" Context="entry">
                    <span class="@GetStatusClass(entry.Status)">@entry.Status</span>
                </TemplateColumn>
                <PropertyColumn Property="@(e => e.Time)" Title="Time (ms)" />
                <TemplateColumn Title="Replay" Context="entry">
                    <div class="har-replay-cell">
                        <FluentButton Appearance="Appearance.Stealth"
                                      OnClick="() => SelectEntry(entry)"
                                      Style="font-size: 0.85rem; vertical-align: middle"
                                      Class="har-inspect-button">Inspect</FluentButton>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
        </FluentCard>

        @if (State.SelectedEntry is not null)
        {
            <div class="har-selected-details" tabindex="-1" @ref="_selectedDetailsRef">
            <FluentCard Style="padding: 20px;">
                <FluentLabel Typo="Typography.Subject">Selected request</FluentLabel>
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 6px; margin-top: 10px;">
                    <FluentLabel Style="font-weight: 600;">@State.SelectedEntry.Method @SanitizeUrl(State.SelectedEntry.Url)</FluentLabel>
                    <FluentLabel Style="font-size: 0.85rem; opacity: 0.8;">Status @State.SelectedEntry.Status (@State.SelectedEntry.StatusText) | @State.SelectedEntry.Time ms | @State.SelectedEntry.MimeType</FluentLabel>
                    @if (!string.IsNullOrEmpty(State.SelectedEntry.Error) || !string.IsNullOrEmpty(State.SelectedEntry.ServerIpAddress))
                    {
                        <FluentLabel Style="font-size: 0.85rem; opacity: 0.8;">
                            @if (!string.IsNullOrEmpty(State.SelectedEntry.Error))
                            {
                                <span class="status-error">@State.SelectedEntry.Error</span>
                            }
                            @if (!string.IsNullOrEmpty(State.SelectedEntry.ServerIpAddress))
                            {
                                <span> Server IP @State.SelectedEntry.ServerIpAddress</span>
                            }
                        </FluentLabel>
                    }
                </FluentStack>

                <FluentTabs Style="margin-top: 16px;">
                    <FluentTab TabId="request" Label="Request headers">
                        <pre class="har-pre">@FormatHeaders(State.SelectedEntry.RequestHeaders)</pre>
                    </FluentTab>
                    <FluentTab TabId="response" Label="Response headers">
                        <pre class="har-pre">@FormatHeaders(State.SelectedEntry.ResponseHeaders)</pre>
                    </FluentTab>
                    <FluentTab TabId="json" Label="Sanitized payload">
                        <pre class="har-pre">@State.SanitizedEntryJson</pre>
                        <FluentButton Appearance="Appearance.Stealth" OnClick="CopySelectedJson" Style="margin-top: 8px;">Copy JSON</FluentButton>
                    </FluentTab>
                    <FluentTab TabId="curl" Label="Replay (cURL)">
                        <pre class="har-pre">@State.CurlPreview</pre>
                        <FluentButton Appearance="Appearance.Accent" OnClick="CopyVisibleCurl" Style="margin-top: 8px;" Disabled="@string.IsNullOrEmpty(State.CurlPreview)">Copy cURL</FluentButton>
                    </FluentTab>
                </FluentTabs>
            </FluentCard>
            </div>
        }
        else
        {
            <FluentCard Style="padding: 20px;">
                <FluentLabel Typo="Typography.Body">Select a request to preview sanitized details.</FluentLabel>
            </FluentCard>
        }
    }

    @if (!string.IsNullOrWhiteSpace(State.ErrorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error">
            @State.ErrorMessage
        </FluentMessageBar>
    }
</FluentStack>
</div>

@code {
    private readonly List<string> _statusOptions = new() { "All", "2xx", "3xx", "4xx", "5xx" };
    private readonly JsonSerializerOptions _jsonOptions = new() { WriteIndented = true };
    private bool _isBusy;
    private string _busyMessage = string.Empty;
    private ElementReference _selectedDetailsRef;
    private bool _scrollToSelected;
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out _);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToSelected && State.SelectedEntry is not null)
        {
            _scrollToSelected = false;
            // Focusing the details container scrolls it into view
            await _selectedDetailsRef.FocusAsync(preventScroll: false);
        }
    }

    private async Task LoadHarFile(InputFileChangeEventArgs e)
    {
        State.ErrorMessage = string.Empty;
        _isBusy = true;
        _busyMessage = $"Loading {e.File.Name}...";
        StateHasChanged();

        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            State.HarContent = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            State.ErrorMessage = $"Error loading HAR file: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            _busyMessage = string.Empty;
        }
    }

    private async Task ParseHar()
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _busyMessage = "Parsing HAR...";
        StateHasChanged();
        // Parsing runs on the UI thread, so yield to let the spinner render first
        await Task.Delay(1);

        try
        {
            ParseHarContent();
        }
        finally
        {
            _isBusy = false;
            _busyMessage = string.Empty;
        }
    }

    private void ParseHarContent()
    {
        State.ErrorMessage = string.Empty;
        State.Entries.Clear();
        State.FilteredEntries.Clear();
        State.SelectedEntry = null;
        State.SanitizedEntryJson = string.Empty;
        State.CurlPreview = string.Empty;
        State.MethodOptions.Clear();
        State.MethodOptions.Add("All");
        State.Findings.Clear();
        State.NoiseCount = 0;

        try
        {
            State.Entries.AddRange(HarParser.Parse(State.HarContent));

            foreach (var method in State.Entries.Select(e => e.Method).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(m => m))
            {
                State.MethodOptions.Add(method);
            }

            State.NoiseCount = State.Entries.Count(HarAnalyzer.IsNoise);
            State.Findings.AddRange(HarAnalyzer.Analyze(State.Entries));

            ApplyFilters();
        }
        catch (FormatException ex)
        {
            State.ErrorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            State.ErrorMessage = $"Error parsing HAR file: {ex.Message}";
        }
    }

    private void ApplyFilters()
    {
        State.FilteredEntries.Clear();
        foreach (var entry in State.Entries)
        {
            if (MatchesFilters(entry))
            {
                State.FilteredEntries.Add(entry);
            }
        }

        if (State.SelectedEntry is not null && !State.FilteredEntries.Contains(State.SelectedEntry))
        {
            State.SelectedEntry = null;
            State.SanitizedEntryJson = string.Empty;
            State.CurlPreview = string.Empty;
        }
    }

    private bool MatchesFilters(HarEntry entry)
    {
        if (State.OnlyErrors && !entry.IsFailure)
        {
            return false;
        }

        if (State.HideNoise && HarAnalyzer.IsNoise(entry))
        {
            return false;
        }

        if (State.MethodFilter != "All" && !entry.Method.Equals(State.MethodFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (State.StatusFilter != "All" && !StatusMatches(entry.Status, State.StatusFilter))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(State.FilterText))
        {
            return true;
        }

        var term = State.FilterText.Trim();
        return entry.Url.Contains(term, StringComparison.OrdinalIgnoreCase)
               || entry.Host.Contains(term, StringComparison.OrdinalIgnoreCase)
               || entry.RequestHeaders.Any(h => h.Value.Contains(term, StringComparison.OrdinalIgnoreCase))
               || entry.ResponseHeaders.Any(h => h.Value.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static bool StatusMatches(int status, string bucket) => bucket switch
    {
        "2xx" => status is >= 200 and < 300,
        "3xx" => status is >= 300 and < 400,
        "4xx" => status is >= 400 and < 500,
        "5xx" => status >= 500,
        _ => true
    };

    private void SelectEntry(HarEntry entry)
    {
        State.SelectedEntry = entry;
        UpdateSelectedPreview();
        _scrollToSelected = true;
    }

    private void UpdateSelectedPreview()
    {
        if (State.SelectedEntry is null)
        {
            State.SanitizedEntryJson = string.Empty;
            State.CurlPreview = string.Empty;
            return;
        }

        State.SanitizedEntryJson = BuildSanitizedEntryJson(State.SelectedEntry);
        State.CurlPreview = BuildCurlCommand(State.SelectedEntry);
    }

    private string BuildSanitizedEntryJson(HarEntry entry)
    {
        var payload = new
        {
            entry.Method,
            Url = SanitizeUrl(entry.Url),
            RequestHeaders = entry.RequestHeaders.Select(h => new { h.Name, Value = SanitizeHeaderValue(h.Name, h.Value) }),
            RequestBody = SanitizeBody(entry.RequestBody),
            entry.Status,
            ResponseHeaders = entry.ResponseHeaders.Select(h => new { h.Name, Value = SanitizeHeaderValue(h.Name, h.Value) }),
            ResponseBody = SanitizeBody(entry.ResponseBody)
        };

        return JsonSerializer.Serialize(payload, _jsonOptions);
    }

    private string BuildCurlCommand(HarEntry entry)
    {
        var builder = new StringBuilder();
        builder.Append($"curl -X {entry.Method} \"{SanitizeUrl(entry.Url)}\"");

        foreach (var header in entry.RequestHeaders)
        {
            var sanitized = SanitizeHeaderValue(header.Name, header.Value);
            builder.AppendLine();
            builder.Append($"  -H \"{header.Name}: {sanitized}\"");
        }

        var body = SanitizeBody(entry.RequestBody);
        if (!string.IsNullOrWhiteSpace(entry.RequestBody))
        {
            builder.AppendLine();
            builder.Append($"  --data-raw '{EscapeSingleQuotes(body)}'");
        }

        return builder.ToString();
    }

    private string BuildSanitizedHarExport()
    {
        var entries = State.Entries.Select(entry => new
        {
            entry.Method,
            Url = SanitizeUrl(entry.Url),
            Headers = entry.RequestHeaders.Select(h => new { h.Name, Value = SanitizeHeaderValue(h.Name, h.Value) }),
            Body = SanitizeBody(entry.RequestBody),
            entry.Status,
            ResponseHeaders = entry.ResponseHeaders.Select(h => new { h.Name, Value = SanitizeHeaderValue(h.Name, h.Value) }),
            ResponseBody = SanitizeBody(entry.ResponseBody),
            entry.Time
        });

        var payload = new { log = new { entries } };
        return JsonSerializer.Serialize(payload, _jsonOptions);
    }

    private async Task CopySanitizedHar()
    {
        if (!State.Entries.Any())
        {
            return;
        }

        await CopyToClipboard(BuildSanitizedHarExport());
    }

    private async Task CopyVisibleCurl()
    {
        if (!string.IsNullOrEmpty(State.CurlPreview))
        {
            await CopyToClipboard(State.CurlPreview);
        }
    }

    private async Task CopySelectedJson()
    {
        if (!string.IsNullOrEmpty(State.SanitizedEntryJson))
        {
            await CopyToClipboard(State.SanitizedEntryJson);
        }
    }

    private Task CopyToClipboard(string text) => JS.InvokeVoidAsync("navigator.clipboard.writeText", text).AsTask();

    private void OnFilterTextChanged(string value)
    {
        State.FilterText = value ?? string.Empty;
        ApplyFilters();
    }

    private void OnMethodFilterChanged(string? value)
    {
        State.MethodFilter = value ?? "All";
        ApplyFilters();
    }

    private void OnStatusFilterChanged(string? value)
    {
        State.StatusFilter = value ?? "All";
        ApplyFilters();
    }

    private void OnHideNoiseChanged(bool value)
    {
        State.HideNoise = value;
        ApplyFilters();
    }

    private void OnOnlyErrorsChanged(bool value)
    {
        State.OnlyErrors = value;
        ApplyFilters();
    }

    private void ToggleStripQuery(bool value)
    {
        State.StripQuery = value;
        UpdateSelectedPreview();
    }

    private void ToggleRedactAuth(bool value)
    {
        State.RedactAuth = value;
        UpdateSelectedPreview();
    }

    private void ToggleRedactCookies(bool value)
    {
        State.RedactCookies = value;
        UpdateSelectedPreview();
    }

    private void ToggleRedactBodies(bool value)
    {
        State.RedactBodies = value;
        UpdateSelectedPreview();
    }

    private string SanitizeUrl(string url)
    {
        if (!State.StripQuery)
        {
            return url;
        }

        return Uri.TryCreate(url, UriKind.Absolute, out var uri)
            ? uri.GetLeftPart(UriPartial.Path)
            : url;
    }

    private string SanitizeHeaderValue(string name, string value)
    {
        if (State.RedactAuth && name.Contains("authorization", StringComparison.OrdinalIgnoreCase))
        {
            return "[REDACTED]";
        }

        if (State.RedactCookies && name.Contains("cookie", StringComparison.OrdinalIgnoreCase))
        {
            return "[REDACTED]";
        }

        return value;
    }

    private string SanitizeBody(string? body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return string.Empty;
        }

        return State.RedactBodies ? "[REDACTED]" : body;
    }

    private static string EscapeSingleQuotes(string value) => value.Replace("'", "'\\''");

    private string FormatHeaders(IEnumerable<HarHeader> headers)
    {
        var builder = new StringBuilder();
        foreach (var header in headers)
        {
            builder.AppendLine($"{header.Name}: {SanitizeHeaderValue(header.Name, header.Value)}");
        }

        return builder.Length == 0 ? "(none)" : builder.ToString();
    }

    private static string GetStatusClass(int status)
    {
        if (status is >= 200 and < 300)
        {
            return "status-ok";
        }

        if (status is >= 300 and < 400)
        {
            return "status-redirect";
        }

        return "status-error";
    }

    private const int MaxEvidence = 5;

    private static string GetFindingClass(HarFindingSeverity severity) => severity switch
    {
        HarFindingSeverity.Error => "har-finding-error",
        HarFindingSeverity.Warning => "har-finding-warning",
        _ => "har-finding-info"
    };

    private static string GetFindingIcon(HarFindingSeverity severity) => severity switch
    {
        HarFindingSeverity.Error => "⛔",
        HarFindingSeverity.Warning => "⚠️",
        _ => "ℹ️"
    };

    private string FormatEvidence(HarEntry entry)
    {
        var status = entry.Status == 0 ? "ERR" : entry.Status.ToString();
        var url = SanitizeUrl(entry.Url);
        if (url.Length > 70)
        {
            url = url[..67] + "...";
        }

        return $"{status} {entry.Method} {url}";
    }

    private sealed class PageState
    {
        public string HarContent = string.Empty;
        public string ErrorMessage = string.Empty;
        public readonly List<HarEntry> Entries = new();
        public readonly List<HarEntry> FilteredEntries = new();
        public readonly List<string> MethodOptions = new() { "All" };
        public HarEntry? SelectedEntry;
        public string FilterText = string.Empty;
        public string MethodFilter = "All";
        public string StatusFilter = "All";
        public bool OnlyErrors;
        public bool StripQuery = true;
        public bool RedactAuth = true;
        public bool RedactCookies = true;
        public bool RedactBodies = true;
        public string SanitizedEntryJson = string.Empty;
        public string CurlPreview = string.Empty;
        public bool HideNoise;
        public int NoiseCount;
        public readonly List<HarFinding> Findings = new();
    }
}
