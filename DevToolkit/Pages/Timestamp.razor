@page "/timestamp"
@using DevToolkit.Infrastructure
@attribute [ToolPage("Timestamp", "🕒", "Convert Unix timestamps and DateTime values.", 6)]
@using DevToolkit.Services
@inject ToolStateStore Store

<PageTitle>Timestamp</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px; height: 100%;">
    <FluentLabel Typo="Typography.PageTitle">Timestamp / DateTime Converter</FluentLabel>

    <FluentCard Style="padding: 20px;">
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
            <FluentLabel Typo="Typography.Subject">Unix Timestamp (seconds or milliseconds)</FluentLabel>
            <FluentTextField Value="@State.UnixInput" ValueChanged="@((string v) => State.UnixInput = v)" Placeholder="e.g. 1716375296 or 1716375296000" Style="width: 100%;" />
            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px;">
                <FluentButton Appearance="Appearance.Accent" OnClick="ConvertFromUnix">Convert from Unix</FluentButton>
            </FluentStack>

            <FluentLabel Typo="Typography.Subject">DateTime</FluentLabel>
            <FluentTextField Value="@State.DateTimeInput" ValueChanged="@((string v) => State.DateTimeInput = v)" Placeholder="e.g. 2026-01-31T10:45:00Z" Style="width: 100%;" />
            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px;">
                <FluentButton Appearance="Appearance.Accent" OnClick="ConvertFromDateTime">Convert from DateTime</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="SetNow">Use Now</FluentButton>
            </FluentStack>

            @if (!string.IsNullOrWhiteSpace(State.ErrorMessage))
            {
                <FluentMessageBar Intent="MessageIntent.Error">@State.ErrorMessage</FluentMessageBar>
            }
        </FluentStack>
    </FluentCard>

    <FluentCard Style="padding: 20px;">
        <FluentLabel Typo="Typography.Subject">Results</FluentLabel>
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px; margin-top: 10px;">
            <FluentLabel><strong>UTC:</strong> @State.UtcOutput</FluentLabel>
            <FluentLabel><strong>Local:</strong> @State.LocalOutput</FluentLabel>
            <FluentLabel><strong>Unix Seconds:</strong> @State.UnixSecondsOutput</FluentLabel>
            <FluentLabel><strong>Unix Milliseconds:</strong> @State.UnixMillisecondsOutput</FluentLabel>
            <FluentLabel><strong>ISO-8601:</strong> @State.IsoOutput</FluentLabel>
        </FluentStack>
    </FluentCard>
</FluentStack>
</div>

@code {
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out var isNewState);
        if (!isNewState)
        {
            return;
        }

        SetNow();
    }

    private void ConvertFromUnix()
    {
        State.ErrorMessage = string.Empty;

        if (!long.TryParse(State.UnixInput.Trim(), out var unixValue))
        {
            State.ErrorMessage = "Invalid Unix value.";
            return;
        }

        try
        {
            var dto = unixValue > 9_999_999_999
                ? DateTimeOffset.FromUnixTimeMilliseconds(unixValue)
                : DateTimeOffset.FromUnixTimeSeconds(unixValue);

            SetOutputs(dto);
            State.DateTimeInput = dto.UtcDateTime.ToString("o");
        }
        catch (Exception ex)
        {
            State.ErrorMessage = $"Conversion error: {ex.Message}";
        }
    }

    private void ConvertFromDateTime()
    {
        State.ErrorMessage = string.Empty;

        if (!DateTimeOffset.TryParse(State.DateTimeInput, out var dto))
        {
            State.ErrorMessage = "Invalid DateTime value.";
            return;
        }

        SetOutputs(dto);
        State.UnixInput = dto.ToUnixTimeMilliseconds().ToString();
    }

    private void SetNow()
    {
        var now = DateTimeOffset.UtcNow;
        State.DateTimeInput = now.ToString("o");
        State.UnixInput = now.ToUnixTimeMilliseconds().ToString();
        SetOutputs(now);
        State.ErrorMessage = string.Empty;
    }

    private void SetOutputs(DateTimeOffset dto)
    {
        State.UtcOutput = dto.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");
        State.LocalOutput = dto.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss zzz");
        State.UnixSecondsOutput = dto.ToUnixTimeSeconds().ToString();
        State.UnixMillisecondsOutput = dto.ToUnixTimeMilliseconds().ToString();
        State.IsoOutput = dto.ToString("o");
    }

    private sealed class PageState
    {
        public string UnixInput = string.Empty;
        public string DateTimeInput = string.Empty;
        public string ErrorMessage = string.Empty;
        public string UtcOutput = "-";
        public string LocalOutput = "-";
        public string UnixSecondsOutput = "-";
        public string UnixMillisecondsOutput = "-";
        public string IsoOutput = "-";
    }
}
