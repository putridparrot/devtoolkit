@code {
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out var isNewState);
        if (!isNewState)
        {
            return;
        }

        var zones = TimeZoneInfo.GetSystemTimeZones();
        foreach (var zone in zones)
        {
            State.Timezones.Add(new TimeZoneOption(zone.Id, $"{zone.DisplayName} [{zone.Id}]"));
        }

        State.ReferenceZone = FindZoneOption(TimeZoneInfo.Local.Id) ?? State.Timezones.FirstOrDefault();
        State.MeetingZone = State.ReferenceZone;
        State.ZoneToAdd = State.Timezones.FirstOrDefault(z => string.Equals(z.Id, TimeZoneInfo.Utc.Id, StringComparison.OrdinalIgnoreCase));
        State.ParticipantZone = State.ReferenceZone;

        ResetTrackedDefaults();

        State.Participants.Add(new MeetingParticipant(global::System.Guid.NewGuid().ToString("N"), "You", State.ReferenceZone?.Id ?? TimeZoneInfo.Local.Id));

        RefreshSnapshots();
        RefreshParticipants();
        RefreshSuggestions();
    }

    private void OnReferenceInputChanged(ChangeEventArgs args)
    {
        if (TryParseInput(args.Value, out var value))
        {
            State.ReferenceLocalTime = value;
            RefreshSnapshots();
            StateHasChanged();
        }
    }

    private void OnMeetingInputChanged(ChangeEventArgs args)
    {
        if (TryParseInput(args.Value, out var value))
        {
            State.MeetingLocalTime = value;
            RefreshParticipants();
            RefreshSuggestions();
            StateHasChanged();
        }
    }

    private static bool TryParseInput(object? value, out DateTime result)
    {
        var text = value?.ToString();
        if (!string.IsNullOrWhiteSpace(text) && DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var parsed))
        {
            result = DateTime.SpecifyKind(parsed, DateTimeKind.Unspecified);
            return true;
        }

        result = DateTime.Now;
        return false;
    }

    private string ReferenceInputValue => State.ReferenceLocalTime.ToString("yyyy-MM-ddTHH:mm");
    private string MeetingInputValue => State.MeetingLocalTime.ToString("yyyy-MM-ddTHH:mm");

    private string ReferenceSummary
    {
        get
        {
            var zone = ResolveZone(State.ReferenceZone?.Id) ?? TimeZoneInfo.Local;
            var instant = CreateInstant(State.ReferenceLocalTime, zone);
            var offset = zone.GetUtcOffset(instant.UtcDateTime);
            var offsetText = FormatOffset(offset);
            return $"{instant.ToString("ddd, MMM d yyyy HH:mm", CultureInfo.InvariantCulture)} ({zone.Id}, {offsetText})";
        }
    }
    
    private TimeZoneOption? ReferenceZone
    {
        get => State.ReferenceZone;
        set
        {
            if ((State.ReferenceZone is null && value is null) ||
                (State.ReferenceZone is not null && value is not null && string.Equals(State.ReferenceZone.Id, value.Id, StringComparison.OrdinalIgnoreCase)))
            {
                return;
            }

            State.ReferenceZone = value;
            RefreshSnapshots();
        }
    }

    private TimeZoneOption? MeetingZone
    {
        get => State.MeetingZone;
        set
        {
            if ((State.MeetingZone is null && value is null) ||
                (State.MeetingZone is not null && value is not null && string.Equals(State.MeetingZone.Id, value.Id, StringComparison.OrdinalIgnoreCase)))
            {
                return;
            }

            State.MeetingZone = value;
            RefreshParticipants();
            RefreshSuggestions();
        }
    }

    private void SetReferenceNow()
    {
        State.ReferenceLocalTime = DateTime.Now;
        RefreshSnapshots();
    }

    private void ShiftReferenceHours(int hours)
    {
        State.ReferenceLocalTime = State.ReferenceLocalTime.AddHours(hours);
        RefreshSnapshots();
    }

    private void SetMeetingNow()
    {
        State.MeetingLocalTime = DateTime.Now;
        RefreshParticipants();
        RefreshSuggestions();
    }

    private void ShiftMeetingHours(int hours)
    {
        State.MeetingLocalTime = State.MeetingLocalTime.AddHours(hours);
        RefreshParticipants();
        RefreshSuggestions();
    }

    private void UpdateWorkdayStart(int value)
    {
        State.WorkdayStart = Math.Clamp(value, 0, Math.Min(State.WorkdayEnd - 1, 23));
        RefreshParticipants();
        RefreshSuggestions();
    }

    private void UpdateWorkdayEnd(int value)
    {
        State.WorkdayEnd = Math.Clamp(value, Math.Max(State.WorkdayStart + 1, 1), 24);
        RefreshParticipants();
        RefreshSuggestions();
    }

    private void AddTrackedZone()
    {
        if (State.ZoneToAdd is null)
        {
            SetTimezoneMessage("Select a timezone to add.", MessageIntent.Warning);
            return;
        }

        if (TrackedContains(State.ZoneToAdd.Id))
        {
            SetTimezoneMessage("That timezone is already in the list.", MessageIntent.Warning);
            return;
        }

        State.TrackedZoneIds.Add(State.ZoneToAdd.Id);
        SetTimezoneMessage($"Added {State.ZoneToAdd.Id}.", MessageIntent.Success);
        RefreshSnapshots();
    }

    private void RemoveTrackedZone(string zoneId)
    {
        State.TrackedZoneIds.RemoveAll(z => string.Equals(z, zoneId, StringComparison.OrdinalIgnoreCase));
        RefreshSnapshots();
    }

    private void ClearTrackedZones()
    {
        ResetTrackedDefaults();
        SetTimezoneMessage("Reset to local + UTC + suggestions.", MessageIntent.Info);
        RefreshSnapshots();
    }

    private void ResetTrackedDefaults()
    {
        State.TrackedZoneIds.Clear();
        var referenceId = State.ReferenceZone?.Id ?? TimeZoneInfo.Local.Id;
        State.TrackedZoneIds.Add(referenceId);
        if (!TrackedContains(TimeZoneInfo.Utc.Id))
        {
            State.TrackedZoneIds.Add(TimeZoneInfo.Utc.Id);
        }

        foreach (var hint in new[] { "Eastern", "London", "Berlin", "Tokyo", "Sydney" })
        {
            var match = State.Timezones.FirstOrDefault(z => z.Label.Contains(hint, StringComparison.OrdinalIgnoreCase));
            if (match is not null && !TrackedContains(match.Id))
            {
                State.TrackedZoneIds.Add(match.Id);
            }
        }
    }

    private bool TrackedContains(string id)
    {
        return State.TrackedZoneIds.Any(z => string.Equals(z, id, StringComparison.OrdinalIgnoreCase));
    }

    private void SetTimezoneMessage(string message, MessageIntent intent)
    {
        State.TimezoneMessage = message;
        State.TimezoneMessageIntent = intent;
    }

    private void AddParticipant()
    {
        if (string.IsNullOrWhiteSpace(State.NewParticipantName))
        {
            SetPlannerMessage("Enter a participant name.", MessageIntent.Warning);
            return;
        }

        if (State.ParticipantZone is null)
        {
            SetPlannerMessage("Select a participant timezone.", MessageIntent.Warning);
            return;
        }

        State.Participants.Add(new MeetingParticipant(global::System.Guid.NewGuid().ToString("N"), State.NewParticipantName.Trim(), State.ParticipantZone.Id));
        State.NewParticipantName = string.Empty;
        SetPlannerMessage($"Added participant for {State.ParticipantZone.Id}.", MessageIntent.Success);
        RefreshParticipants();
        RefreshSuggestions();
    }

    private void RemoveParticipant(string id)
    {
        State.Participants.RemoveAll(p => p.Id == id);
        RefreshParticipants();
        RefreshSuggestions();
    }

    private void SetPlannerMessage(string message, MessageIntent intent)
    {
        State.PlannerMessage = message;
        State.PlannerMessageIntent = intent;
    }

    private void RefreshSnapshots()
    {
        State.TimeSnapshots = State.TrackedZoneIds
            .Select(id => BuildSnapshot(id))
            .Where(snapshot => snapshot is not null)
            .Select(snapshot => snapshot!)
            .OrderBy(s => s.SortKey)
            .ToList();
    }

    private void RefreshParticipants()
    {
        State.ParticipantViews = State.Participants
            .Select(p => BuildParticipantView(p))
            .Where(view => view is not null)
            .Select(view => view!)
            .ToList();
    }

    private void RefreshSuggestions()
    {
        State.SuggestedSlots = FindSuggestedSlots();
    }

    private ZoneSnapshot? BuildSnapshot(string zoneId)
    {
        var zone = ResolveZone(zoneId);
        if (zone is null)
        {
            return null;
        }

        var referenceZone = ResolveZone(State.ReferenceZone?.Id) ?? TimeZoneInfo.Local;
        var instant = CreateInstant(State.ReferenceLocalTime, referenceZone);
        var localTime = TimeZoneInfo.ConvertTime(instant, zone);
        var deltaHours = (localTime - instant).TotalHours;

        return new ZoneSnapshot(
            zone.Id,
            zone.DisplayName,
            localTime.ToString("ddd, MMM d • HH:mm", CultureInfo.InvariantCulture),
            FormatOffset(zone.GetUtcOffset(localTime.UtcDateTime)),
            DescribeDelta(deltaHours),
            DescribeDayDifference(localTime, instant),
            string.Equals(zone.Id, referenceZone.Id, StringComparison.OrdinalIgnoreCase),
            deltaHours);
    }

    private ParticipantView? BuildParticipantView(MeetingParticipant participant)
    {
        var zone = ResolveZone(participant.TimeZoneId);
        if (zone is null)
        {
            return null;
        }

        var anchorZone = ResolveZone(State.MeetingZone?.Id) ?? TimeZoneInfo.Local;
        var anchorInstant = CreateInstant(State.MeetingLocalTime, anchorZone);
        var local = TimeZoneInfo.ConvertTime(anchorInstant, zone);
        var withinHours = IsWithinWorkingHours(local.TimeOfDay);
        var status = withinHours ? "Within working hours" : "Outside working hours";

        return new ParticipantView(
            participant.Id,
            participant.Name,
            zone.DisplayName,
            local.ToString("ddd, MMM d • HH:mm", CultureInfo.InvariantCulture),
            DescribeDayDifference(local, anchorInstant),
            withinHours,
            status);
    }

    private List<SuggestedSlot> FindSuggestedSlots()
    {
        var results = new List<SuggestedSlot>();
        if (State.Participants.Count == 0)
        {
            return results;
        }

        var anchorZone = ResolveZone(State.MeetingZone?.Id) ?? TimeZoneInfo.Local;
        var anchorInstant = CreateInstant(State.MeetingLocalTime, anchorZone);
        var candidate = anchorInstant;
        var iterations = 0;

        while (results.Count < 5 && iterations < 72)
        {
            if (AllParticipantsWithinHours(candidate))
            {
                var details = State.Participants
                    .Select(p => BuildSlotParticipant(candidate, p))
                    .Where(d => d is not null)
                    .Select(d => d!)
                    .ToList();

                if (details.Count == State.Participants.Count)
                {
                    var anchorText = TimeZoneInfo.ConvertTime(candidate, anchorZone)
                        .ToString("ddd, MMM d • HH:mm", CultureInfo.InvariantCulture);
                    results.Add(new SuggestedSlot($"{anchorText} ({anchorZone.Id})", details));
                }
            }

            candidate = candidate.AddHours(1);
            iterations++;
        }

        return results;
    }

    private bool AllParticipantsWithinHours(DateTimeOffset instant)
    {
        foreach (var participant in State.Participants)
        {
            var zone = ResolveZone(participant.TimeZoneId);
            if (zone is null)
            {
                return false;
            }

            var local = TimeZoneInfo.ConvertTime(instant, zone);
            if (!IsWithinWorkingHours(local.TimeOfDay))
            {
                return false;
            }
        }

        return true;
    }

    private SlotParticipant? BuildSlotParticipant(DateTimeOffset instant, MeetingParticipant participant)
    {
        var zone = ResolveZone(participant.TimeZoneId);
        if (zone is null)
        {
            return null;
        }

        var local = TimeZoneInfo.ConvertTime(instant, zone);
        return new SlotParticipant(
            participant.Name,
            local.ToString("ddd, MMM d • HH:mm", CultureInfo.InvariantCulture),
            DescribeDayDifference(local, instant));
    }

    private static string DescribeDelta(double hours)
    {
        if (Math.Abs(hours) < 0.01)
        {
            return "Same as reference";
        }

        var sign = hours > 0 ? "ahead" : "behind";
        return $"{Math.Abs(hours):0.#}h {sign}";
    }

    private static string DescribeDayDifference(DateTimeOffset local, DateTimeOffset anchor)
    {
        var delta = (local.Date - anchor.Date).Days;
        var plural = Math.Abs(delta) == 1 ? string.Empty : "s";
        return delta switch
        {
            0 => "Today",
            1 => "Tomorrow",
            -1 => "Yesterday",
            _ => delta > 0 ? $"+{delta} day{plural}" : $"{delta} day{plural}"
        };
    }

    private static string FormatOffset(TimeSpan offset)
    {
        var sign = offset < TimeSpan.Zero ? "-" : "+";
        offset = offset.Duration();
        return $"UTC{sign}{offset.Hours:00}:{offset.Minutes:00}";
    }

    private bool IsWithinWorkingHours(TimeSpan time)
    {
        var hourFraction = time.TotalHours;
        return hourFraction >= State.WorkdayStart && hourFraction < State.WorkdayEnd;
    }

    private TimeZoneInfo? ResolveZone(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(id);
        }
        catch
        {
            return null;
        }
    }

    private TimeZoneOption? FindZoneOption(string id)
    {
        return State.Timezones.FirstOrDefault(z => string.Equals(z.Id, id, StringComparison.OrdinalIgnoreCase));
    }

    private static DateTimeOffset CreateInstant(DateTime localTime, TimeZoneInfo zone)
    {
        var unspecified = DateTime.SpecifyKind(localTime, DateTimeKind.Unspecified);
        var offset = zone.GetUtcOffset(unspecified);
        return new DateTimeOffset(unspecified, offset);
    }

    private sealed record TimeZoneOption(string Id, string Label)
    {
        public override string ToString() => Label;
    }

    private sealed record MeetingParticipant(string Id, string Name, string TimeZoneId);

    private sealed record ZoneSnapshot(
        string ZoneId,
        string DisplayName,
        string LocalText,
        string OffsetText,
        string DeltaText,
        string DayNote,
        bool IsReference,
        double SortKey);

    private sealed record ParticipantView(
        string Id,
        string Name,
        string ZoneLabel,
        string LocalMeetingText,
        string DayNote,
        bool WithinHours,
        string StatusText);

    private sealed record SuggestedSlot(string AnchorDescription, List<SlotParticipant> Participants);

    private sealed record SlotParticipant(string Name, string LocalText, string DayNote);

    private sealed class PageState
    {
        public readonly List<string> TrackedZoneIds = new();
        public readonly List<MeetingParticipant> Participants = new();
        public readonly List<TimeZoneOption> Timezones = new();
        public TimeZoneOption? ReferenceZone;
        public TimeZoneOption? MeetingZone;
        public TimeZoneOption? ZoneToAdd;
        public TimeZoneOption? ParticipantZone;
        public DateTime ReferenceLocalTime = DateTime.Now;
        public DateTime MeetingLocalTime = DateTime.Now.AddHours(1);
        public int WorkdayStart = 9;
        public int WorkdayEnd = 17;
        public string? TimezoneMessage;
        public MessageIntent TimezoneMessageIntent = MessageIntent.Info;
        public string? PlannerMessage;
        public MessageIntent PlannerMessageIntent = MessageIntent.Info;
        public string NewParticipantName = string.Empty;
        public List<ZoneSnapshot> TimeSnapshots = new();
        public List<ParticipantView> ParticipantViews = new();
        public List<SuggestedSlot> SuggestedSlots = new();
    }
}
