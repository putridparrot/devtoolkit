@page "/hash-hmac"
@attribute [ToolPage("Hash/HMAC", "#️⃣", "Generate MD5/SHA hashes and HMAC signatures.", 12)]
@using DevToolkit.Services
@inject ToolStateStore Store
@using System.Security.Cryptography
@using System.Text
@using DevToolkit.Infrastructure

<PageTitle>Hash/HMAC</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px; height: 100%;">
    <FluentLabel Typo="Typography.PageTitle">Hash / HMAC Tools</FluentLabel>

    <FluentCard Style="padding: 20px;">
        <FluentTabs>
            <FluentTab Label="Hash">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px; padding: 20px;">
                    <FluentLabel Typo="Typography.Subject">Input</FluentLabel>
                    <FluentTextArea Value="@State.HashInput" ValueChanged="@((string v) => State.HashInput = v)" Rows="8" Style="width: 100%; font-family: monospace;" />

                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; align-items: center;">
                        <FluentLabel>Algorithm</FluentLabel>
                        <FluentSelect Items="@_algorithms" @bind-SelectedOption="State.SelectedHashAlgorithm" Style="width: 140px;">
                            <OptionTemplate>@context</OptionTemplate>
                        </FluentSelect>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px;">
                        <FluentButton Appearance="Appearance.Accent" OnClick="GenerateHash">Generate Hash</FluentButton>
                        <FluentButton Appearance="Appearance.Outline" OnClick="ClearHash">Clear</FluentButton>
                    </FluentStack>

                    @if (!string.IsNullOrWhiteSpace(State.HashErrorMessage))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error">@State.HashErrorMessage</FluentMessageBar>
                    }

                    <FluentLabel Typo="Typography.Subject">Output (Hex)</FluentLabel>
                    <FluentTextArea Value="@State.HashOutput" ValueChanged="@((string v) => State.HashOutput = v)" Rows="4" Style="width: 100%; font-family: monospace;" />
                </FluentStack>
            </FluentTab>

            <FluentTab Label="HMAC">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px; padding: 20px;">
                    <FluentLabel Typo="Typography.Subject">Input</FluentLabel>
                    <FluentTextArea Value="@State.HmacInput" ValueChanged="@((string v) => State.HmacInput = v)" Rows="8" Style="width: 100%; font-family: monospace;" />

                    <FluentLabel Typo="Typography.Subject">Secret Key</FluentLabel>
                    <FluentTextField Value="@State.HmacKey" ValueChanged="@((string v) => State.HmacKey = v)" TextFieldType="TextFieldType.Password" Style="width: 100%;" />

                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; align-items: center;">
                        <FluentLabel>Algorithm</FluentLabel>
                        <FluentSelect Items="@_hmacAlgorithms" @bind-SelectedOption="State.SelectedHmacAlgorithm" Style="width: 140px;">
                            <OptionTemplate>@context</OptionTemplate>
                        </FluentSelect>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px;">
                        <FluentButton Appearance="Appearance.Accent" OnClick="GenerateHmac">Generate HMAC</FluentButton>
                        <FluentButton Appearance="Appearance.Outline" OnClick="ClearHmac">Clear</FluentButton>
                    </FluentStack>

                    @if (!string.IsNullOrWhiteSpace(State.HmacErrorMessage))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error">@State.HmacErrorMessage</FluentMessageBar>
                    }

                    <FluentLabel Typo="Typography.Subject">Output (Hex)</FluentLabel>
                    <FluentTextArea Value="@State.HmacOutput" ValueChanged="@((string v) => State.HmacOutput = v)" Rows="4" Style="width: 100%; font-family: monospace;" />
                </FluentStack>
            </FluentTab>
        </FluentTabs>
    </FluentCard>
</FluentStack>
</div>

@code {
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out _);
    }

    private readonly List<string> _algorithms = ["MD5", "SHA1", "SHA256", "SHA384", "SHA512"];
    private readonly List<string> _hmacAlgorithms = ["SHA1", "SHA256", "SHA384", "SHA512"];




    private void GenerateHash()
    {
        State.HashErrorMessage = string.Empty;

        try
        {
            var bytes = Encoding.UTF8.GetBytes(State.HashInput);
            var hashed = State.SelectedHashAlgorithm switch
            {
                "MD5" => MD5.HashData(bytes),
                "SHA1" => SHA1.HashData(bytes),
                "SHA384" => SHA384.HashData(bytes),
                "SHA512" => SHA512.HashData(bytes),
                _ => SHA256.HashData(bytes)
            };

            State.HashOutput = ConvertToHex(hashed);
        }
        catch (Exception ex)
        {
            State.HashErrorMessage = $"Error generating hash: {ex.Message}";
        }
    }

    private void GenerateHmac()
    {
        State.HmacErrorMessage = string.Empty;

        if (string.IsNullOrEmpty(State.HmacKey))
        {
            State.HmacErrorMessage = "Secret key is required for HMAC.";
            return;
        }

        try
        {
            var keyBytes = Encoding.UTF8.GetBytes(State.HmacKey);
            var dataBytes = Encoding.UTF8.GetBytes(State.HmacInput);

            byte[] mac = State.SelectedHmacAlgorithm switch
            {
                "SHA1" => HMACSHA1.HashData(keyBytes, dataBytes),
                "SHA384" => HMACSHA384.HashData(keyBytes, dataBytes),
                "SHA512" => HMACSHA512.HashData(keyBytes, dataBytes),
                _ => HMACSHA256.HashData(keyBytes, dataBytes)
            };

            State.HmacOutput = ConvertToHex(mac);
        }
        catch (Exception ex)
        {
            State.HmacErrorMessage = $"Error generating HMAC: {ex.Message}";
        }
    }

    private static string ConvertToHex(byte[] bytes)
    {
        var sb = new StringBuilder(bytes.Length * 2);
        foreach (var b in bytes)
        {
            sb.Append(b.ToString("x2"));
        }
        return sb.ToString();
    }

    private void ClearHash()
    {
        State.HashInput = string.Empty;
        State.HashOutput = string.Empty;
        State.HashErrorMessage = string.Empty;
    }

    private void ClearHmac()
    {
        State.HmacInput = string.Empty;
        State.HmacKey = string.Empty;
        State.HmacOutput = string.Empty;
        State.HmacErrorMessage = string.Empty;
    }

    private sealed class PageState
    {
        public string SelectedHashAlgorithm = "SHA256";
        public string SelectedHmacAlgorithm = "SHA256";
        public string HashInput = string.Empty;
        public string HashOutput = string.Empty;
        public string HashErrorMessage = string.Empty;
        public string HmacInput = string.Empty;
        public string HmacKey = string.Empty;
        public string HmacOutput = string.Empty;
        public string HmacErrorMessage = string.Empty;
    }
}
