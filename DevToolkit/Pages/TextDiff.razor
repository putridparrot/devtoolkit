@page "/text-diff"
@attribute [ToolPage("Text Diff", "🧾", "Spot differences between snippets, configs, or payloads.", 17)]
@using DevToolkit.Services
@inject ToolStateStore Store
@using DevToolkit.Infrastructure
@using DiffPlex
@using DiffPlex.Chunkers
@using DiffPlex.DiffBuilder
@using DiffPlex.DiffBuilder.Model
@using System.Net
@using System.Linq
@using System.Text

<PageTitle>Text Diff</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px;">
    <FluentLabel Typo="Typography.PageTitle">Text / Config Diff</FluentLabel>

    <FluentCard Style="padding: 20px;">
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px;">
            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 20px; flex-wrap: wrap;">
                <FluentStack Orientation="Orientation.Vertical" Style="flex: 1 1 300px; gap: 8px;">
                    <FluentLabel Typo="Typography.Subject">Left Text</FluentLabel>
                    <FluentTextArea Value="@State.LeftText"
                                    ValueChanged="@((string value) => State.LeftText = value)"
                                    Rows="14"
                                    Style="width: 100%; font-family: monospace;" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" Style="flex: 1 1 300px; gap: 8px;">
                    <FluentLabel Typo="Typography.Subject">Right Text</FluentLabel>
                    <FluentTextArea Value="@State.RightText"
                                    ValueChanged="@((string value) => State.RightText = value)"
                                    Rows="14"
                                    Style="width: 100%; font-family: monospace;" />
                </FluentStack>
            </FluentStack>

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 20px; flex-wrap: wrap; align-items: center;">
                <FluentCheckbox Value="State.IgnoreWhitespace"
                                ValueChanged="(bool value) => State.IgnoreWhitespace = value"
                                Label="Ignore whitespace" />
                <FluentCheckbox Value="State.IgnoreCase"
                                ValueChanged="(bool value) => State.IgnoreCase = value"
                                Label="Ignore case" />
            </FluentStack>

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; flex-wrap: wrap;">
                <FluentButton Appearance="Appearance.Accent" OnClick="CompareText">Run Diff</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="SwapSides">Swap Inputs</FluentButton>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearAll">Clear</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    @if (!string.IsNullOrWhiteSpace(State.StatusMessage))
    {
        <FluentMessageBar Intent="@State.StatusIntent">@State.StatusMessage</FluentMessageBar>
    }

    @if (State.DiffResult is not null)
    {
        <FluentCard Style="padding: 20px;">
            <FluentLabel Typo="Typography.Subject">Summary</FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 20px; flex-wrap: wrap; margin-top: 8px;">
                <FluentLabel><strong>Added:</strong> @State.Summary.Added</FluentLabel>
                <FluentLabel><strong>Removed:</strong> @State.Summary.Removed</FluentLabel>
                <FluentLabel><strong>Modified:</strong> @State.Summary.Modified</FluentLabel>
                <FluentLabel><strong>Total changes:</strong> @State.Summary.TotalChanges</FluentLabel>
            </FluentStack>
        </FluentCard>

        <FluentCard Style="padding: 20px;">
            <FluentLabel Typo="Typography.Subject">Diff Output</FluentLabel>
            <div class="diff-output" aria-label="diff results">
                @for (var i = 0; i < State.DiffResult.Lines.Count; i++)
                {
                    var line = State.DiffResult.Lines[i];
                    var cssClass = $"diff-line {CssModifier(line.Type)}";
                    <div class="@cssClass">
                        <span class="diff-line-marker">@MarkerFor(line.Type)</span>
                        <pre>@((MarkupString)FormatLine(i, line))</pre>
                    </div>
                }
            </div>
        </FluentCard>
    }
</FluentStack>
</div>

@code {
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out _);
    }

    private readonly InlineDiffBuilder _diffBuilder = new(new Differ());
    private readonly IChunker _chunker = new LineChunker();





    private void CompareText()
    {
        State.StatusMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(State.LeftText) && string.IsNullOrWhiteSpace(State.RightText))
        {
            State.DiffResult = null;
            State.Summary = DiffSummary.Empty;
            State.StatusIntent = MessageIntent.Info;
            State.StatusMessage = "Enter or paste text in at least one panel.";
            return;
        }

        State.DiffResult = _diffBuilder.BuildDiffModel(
            State.LeftText ?? string.Empty,
            State.RightText ?? string.Empty,
            State.IgnoreWhitespace,
            State.IgnoreCase,
            _chunker);

        State.Summary = DiffSummary.From(State.DiffResult);

        if (State.Summary.TotalChanges == 0)
        {
            State.StatusIntent = MessageIntent.Success;
            State.StatusMessage = "No differences detected.";
        }
        else
        {
            State.StatusIntent = MessageIntent.Info;
            State.StatusMessage = $"Found {State.Summary.TotalChanges} change(s).";
        }
    }

    private void SwapSides()
    {
        (State.LeftText, State.RightText) = (State.RightText, State.LeftText);
    }

    private void ClearAll()
    {
        State.LeftText = string.Empty;
        State.RightText = string.Empty;
        State.DiffResult = null;
        State.Summary = DiffSummary.Empty;
        State.StatusMessage = string.Empty;
    }

    private static string MarkerFor(ChangeType type) => type switch
    {
        ChangeType.Inserted => "+",
        ChangeType.Deleted => "-",
        ChangeType.Modified => "~",
        _ => " "
    };

    private static string CssModifier(ChangeType type) => type switch
    {
        ChangeType.Inserted => "diff-line-inserted",
        ChangeType.Deleted => "diff-line-deleted",
        ChangeType.Modified => "diff-line-modified",
        _ => "diff-line-unchanged"
    };

    private string FormatLine(int index, DiffPiece line)
    {
        var lineText = line.Text ?? string.Empty;
        var counterpartText = FindCounterpartText(index, line.Type);

        if (counterpartText is null)
        {
            return WebUtility.HtmlEncode(lineText);
        }

        var builder = new StringBuilder();
        var maxLength = Math.Max(lineText.Length, counterpartText.Length);
        for (var i = 0; i < maxLength; i++)
        {
            if (i >= lineText.Length)
            {
                continue;
            }

            var currentChar = lineText[i];
            var hasCounterpartChar = i < counterpartText.Length;
            var counterpartChar = hasCounterpartChar ? counterpartText[i] : '\0';
            var isDifferent = !hasCounterpartChar || !CharsEqual(currentChar, counterpartChar);
            var encodedChar = WebUtility.HtmlEncode(currentChar.ToString());

            if (!isDifferent)
            {
                builder.Append(encodedChar);
            }
            else
            {
                var css = CharCssModifier(line.Type);
                builder.Append("<span class=\"")
                    .Append(css)
                    .Append("\">")
                    .Append(encodedChar)
                    .Append("</span>");
            }
        }

        return builder.ToString();
    }

    private string? FindCounterpartText(int index, ChangeType type)
    {
        if (State.DiffResult is null)
        {
            return null;
        }

        var lines = State.DiffResult.Lines;

        static bool IsComparable(ChangeType t) => t is ChangeType.Inserted or ChangeType.Deleted or ChangeType.Modified;

        if (!IsComparable(type))
        {
            return null;
        }

        for (var offset = 1; offset <= 2; offset++)
        {
            var forward = index + offset;
            if (forward < lines.Count && lines[forward].Type != type && IsComparable(lines[forward].Type))
            {
                return lines[forward].Text ?? string.Empty;
            }

            var backward = index - offset;
            if (backward >= 0 && lines[backward].Type != type && IsComparable(lines[backward].Type))
            {
                return lines[backward].Text ?? string.Empty;
            }
        }

        return null;
    }

    private bool CharsEqual(char left, char right)
        => State.IgnoreCase
            ? char.ToUpperInvariant(left) == char.ToUpperInvariant(right)
            : left == right;

    private static string CharCssModifier(ChangeType type) => type switch
    {
        ChangeType.Inserted => "diff-char-inserted",
        ChangeType.Deleted => "diff-char-deleted",
        ChangeType.Modified => "diff-char-modified",
        _ => string.Empty
    };

    private sealed record DiffSummary(int Added, int Removed, int Modified)
    {
        public int TotalChanges => Added + Removed + Modified;

        public static DiffSummary Empty { get; } = new(0, 0, 0);

        public static DiffSummary From(DiffPaneModel model)
        {
            var added = model.Lines.Count(line => line.Type == ChangeType.Inserted);
            var removed = model.Lines.Count(line => line.Type == ChangeType.Deleted);
            var modified = model.Lines.Count(line => line.Type == ChangeType.Modified);
            return new DiffSummary(added, removed, modified);
        }
    }

    private sealed class PageState
    {
        public string LeftText = @"GET /api/users HTTP/1.1
Host: api.example.com
Accept: application/json
X-Env: staging";
        public string RightText = @"GET /api/users HTTP/1.1
Host: api.example.com
Accept: application/problem+json
X-Env: production";
        public bool IgnoreWhitespace = true;
        public bool IgnoreCase = false;
        public DiffPaneModel? DiffResult;
        public DiffSummary Summary = DiffSummary.Empty;
        public string StatusMessage = string.Empty;
        public MessageIntent StatusIntent = MessageIntent.Info;
    }
}
