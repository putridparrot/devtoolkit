@page "/date-math"
@attribute [ToolPage("Date Math", "📅", "Compare ranges, build offsets, and understand durations.", 14)]
@using DevToolkit.Services
@inject ToolStateStore Store
@using DevToolkit.Infrastructure
@using Microsoft.FluentUI.AspNetCore.Components
@using System
@using System.Collections.Generic
@using System.Globalization

<PageTitle>Date Math &amp; Duration Lab</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px;">
    <FluentLabel Typo="Typography.PageTitle">Date Math &amp; Duration Lab</FluentLabel>

    <FluentCard Style="padding: 20px; width: 100%;">
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px;">
            <FluentLabel Typo="Typography.Subject">Duration Between Dates</FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px; flex-wrap: wrap;">
                <div class="duration-field">
                    <label>Start</label>
                    <input type="datetime-local" class="duration-input" value="@RangeStartInput" @onchange="OnRangeStartChanged" />
                </div>
                <div class="duration-field">
                    <label>End</label>
                    <input type="datetime-local" class="duration-input" value="@RangeEndInput" @onchange="OnRangeEndChanged" />
                </div>
                <div class="duration-field">
                    <label>Precision</label>
                    <FluentCombobox Items="@_precisionOptions" @bind-SelectedOption="State.SelectedPrecision" Style="min-width: 160px;" Class="readonly-combo">
                        <OptionTemplate>@context</OptionTemplate>
                    </FluentCombobox>
                </div>
            </FluentStack>

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; flex-wrap: wrap;">
                <FluentButton Appearance="Appearance.Accent" OnClick="SetRangeLast24">Last 24h</FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick="SetRangeLast7">Last 7 days</FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick="SetRangeNext30">Next 30 days</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="SwapRange">Swap</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="SnapToMidnight">Snap to midnight</FluentButton>
            </FluentStack>

            @if (!string.IsNullOrWhiteSpace(State.RangeMessage))
            {
                <FluentMessageBar Intent="@State.RangeMessageIntent">@State.RangeMessage</FluentMessageBar>
            }

            <div class="duration-grid">
                @foreach (var metric in State.DurationMetrics)
                {
                    <div class="duration-card">
                        <div class="duration-card-label">@metric.Label</div>
                        <div class="duration-card-value">@metric.Value</div>
                        <div class="duration-card-hint">@metric.Hint</div>
                    </div>
                }
            </div>

            <FluentLabel Typo="Typography.Body">Key timestamps</FluentLabel>
            <div class="timeline-list">
                @foreach (var point in State.RangeTimeline)
                {
                    <div class="timeline-row">
                        <span class="timeline-row-label">@point.Label</span>
                        <span class="timeline-row-value">@point.Value</span>
                        <span class="timeline-row-hint">@point.Hint</span>
                    </div>
                }
            </div>
        </FluentStack>
    </FluentCard>

    <FluentCard Style="padding: 20px; width: 100%;">
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px;">
            <FluentLabel Typo="Typography.Subject">Add / Subtract Duration</FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px; flex-wrap: wrap;">
                <div class="duration-field">
                    <label>Anchor</label>
                    <input type="datetime-local" class="duration-input" value="@OffsetBaseInput" @onchange="OnOffsetBaseChanged" />
                </div>
                <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; flex-wrap: wrap; align-items: flex-end;">
                    <div class="offset-input">
                        <label>Years</label>
                        <FluentNumberField Value="@State.OffsetYears" ValueChanged="@((int? v) => State.OffsetYears = v ?? 0)" Min="-20" Max="20" Style="width: 90px;" />
                    </div>
                    <div class="offset-input">
                        <label>Months</label>
                        <FluentNumberField Value="@State.OffsetMonths" ValueChanged="@((int? v) => State.OffsetMonths = v ?? 0)" Min="-240" Max="240" Style="width: 90px;" />
                    </div>
                    <div class="offset-input">
                        <label>Days</label>
                        <FluentNumberField Value="@State.OffsetDays" ValueChanged="@((int? v) => State.OffsetDays = v ?? 0)" Min="-3650" Max="3650" Style="width: 90px;" />
                    </div>
                    <div class="offset-input">
                        <label>Hours</label>
                        <FluentNumberField Value="@State.OffsetHours" ValueChanged="@((int? v) => State.OffsetHours = v ?? 0)" Min="-1000" Max="1000" Style="width: 90px;" />
                    </div>
                    <div class="offset-input">
                        <label>Minutes</label>
                        <FluentNumberField Value="@State.OffsetMinutes" ValueChanged="@((int? v) => State.OffsetMinutes = v ?? 0)" Min="-60000" Max="60000" Style="width: 90px;" />
                    </div>
                </FluentStack>
                <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; flex-wrap: wrap; align-items: center;">
                    <FluentCheckbox @bind-Value="State.OffsetInvert">Subtract instead</FluentCheckbox>
                    <FluentButton Appearance="Appearance.Accent" OnClick="ApplyOffset">Apply offset</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" OnClick="ResetOffset">Reset</FluentButton>
                </FluentStack>
            </FluentStack>

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; flex-wrap: wrap;">
                <FluentButton Appearance="Appearance.Stealth" OnClick="() => ApplyOffsetPreset(TimeSpan.FromMinutes(30))">+30m</FluentButton>
                <FluentButton Appearance="Appearance.Stealth" OnClick="() => ApplyOffsetPreset(TimeSpan.FromHours(6))">+6h</FluentButton>
                <FluentButton Appearance="Appearance.Stealth" OnClick="() => ApplyOffsetPreset(TimeSpan.FromDays(1))">+1d</FluentButton>
                <FluentButton Appearance="Appearance.Stealth" OnClick="() => ApplyOffsetPreset(TimeSpan.FromDays(7))">+1w</FluentButton>
            </FluentStack>

            @if (State.OffsetSummary is not null)
            {
                <div class="offset-summary">
                    <div>
                        <span class="offset-label">Result</span>
                        <span class="offset-value">@State.OffsetSummary.ResultLocal</span>
                        <span class="offset-hint">Local</span>
                    </div>
                    <div>
                        <span class="offset-label">UTC</span>
                        <span class="offset-value">@State.OffsetSummary.ResultUtc</span>
                        <span class="offset-hint">@State.OffsetSummary.RelativeText</span>
                    </div>
                </div>
            }
        </FluentStack>
    </FluentCard>

@*     <FluentCard Style="padding: 20px; width: 100%;">
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 14px;">
            <FluentLabel Typo="Typography.Subject">Breakdown</FluentLabel>
            <div class="breakdown-list">
                @foreach (var detail in State.BreakdownDetails)
                {
                    <div class="breakdown-item">
                        <div class="breakdown-item-head">@detail.Label</div>
                        <div class="breakdown-item-body">@detail.Description</div>
                    </div>
                }
            </div>
        </FluentStack>
    </FluentCard>
 *@</FluentStack>
</div>

@code {
    private PageState State = null!;

    private readonly List<string> _precisionOptions = new() { "Seconds", "Minutes", "Hours", "Days" };





    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out var isNewState);
        if (!isNewState)
        {
            return;
        }

        RefreshDuration();
        ApplyOffset();
    }

    private string RangeStartInput => State.RangeStart.ToString("yyyy-MM-ddTHH:mm");
    private string RangeEndInput => State.RangeEnd.ToString("yyyy-MM-ddTHH:mm");
    private string OffsetBaseInput => State.OffsetBase.ToString("yyyy-MM-ddTHH:mm");

    private void OnRangeStartChanged(ChangeEventArgs args)
    {
        if (TryParseInput(args.Value, out var value))
        {
            State.RangeStart = value;
            RefreshDuration();
        }
    }

    private void OnRangeEndChanged(ChangeEventArgs args)
    {
        if (TryParseInput(args.Value, out var value))
        {
            State.RangeEnd = value;
            RefreshDuration();
        }
    }

    private void OnOffsetBaseChanged(ChangeEventArgs args)
    {
        if (TryParseInput(args.Value, out var value))
        {
            State.OffsetBase = value;
            ApplyOffset();
        }
    }

    private static bool TryParseInput(object? value, out DateTime result)
    {
        var text = value?.ToString();
        if (!string.IsNullOrWhiteSpace(text) && DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var parsed))
        {
            result = DateTime.SpecifyKind(parsed, DateTimeKind.Local);
            return true;
        }

        result = DateTime.Now;
        return false;
    }

    private void SetRangeLast24()
    {
        State.RangeEnd = DateTime.Now;
        State.RangeStart = State.RangeEnd.AddHours(-24);
        RefreshDuration();
    }

    private void SetRangeLast7()
    {
        State.RangeEnd = DateTime.Now;
        State.RangeStart = State.RangeEnd.AddDays(-7);
        RefreshDuration();
    }

    private void SetRangeNext30()
    {
        State.RangeStart = DateTime.Now;
        State.RangeEnd = State.RangeStart.AddDays(30);
        RefreshDuration();
    }

    private void SwapRange()
    {
        (State.RangeStart, State.RangeEnd) = (State.RangeEnd, State.RangeStart);
        RefreshDuration();
    }

    private void SnapToMidnight()
    {
        State.RangeStart = State.RangeStart.Date;
        State.RangeEnd = State.RangeEnd.Date;
        RefreshDuration();
    }

    private void RefreshDuration()
    {
        State.DurationMetrics.Clear();
        State.RangeTimeline.Clear();
        State.BreakdownDetails.Clear();
        State.RangeMessage = null;

        if (State.RangeEnd < State.RangeStart)
        {
            SetRangeMessage("End precedes start; swapped for calculations.", MessageIntent.Warning);
            (State.RangeStart, State.RangeEnd) = (State.RangeEnd, State.RangeStart);
        }

        var span = State.RangeEnd - State.RangeStart;
        var precisionSpan = PrecisionSpan(span);

        State.DurationMetrics.Add(new MetricView("Total days", span.TotalDays.ToString("0.###", CultureInfo.InvariantCulture), "Exact calendar days"));
        State.DurationMetrics.Add(new MetricView("Total hours", span.TotalHours.ToString("0.###", CultureInfo.InvariantCulture), "Includes fractional hours"));
        State.DurationMetrics.Add(new MetricView("Total minutes", span.TotalMinutes.ToString("0.###", CultureInfo.InvariantCulture), "For timers &amp; SLAs"));
        State.DurationMetrics.Add(new MetricView("Total seconds", span.TotalSeconds.ToString("N0", CultureInfo.InvariantCulture), "High-precision"));

        var weeks = (int)(span.TotalDays / 7);
        var remainingDays = span.TotalDays - (weeks * 7);
        State.DurationMetrics.Add(new MetricView("Weeks + days", $"{weeks}w {remainingDays:0.##}d", "Sprint-friendly"));

        var businessDays = CountBusinessDays(State.RangeStart, State.RangeEnd);
        State.DurationMetrics.Add(new MetricView("Business days", businessDays.ToString(CultureInfo.InvariantCulture), "Mon-Fri only"));

        State.RangeTimeline.Add(new TimelineEntry("Start (local)", State.RangeStart.ToString("ddd, MMM d HH:mm", CultureInfo.InvariantCulture), DescribeRelative(State.RangeStart)));
        State.RangeTimeline.Add(new TimelineEntry("Start (UTC)", State.RangeStart.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture), ""));
        State.RangeTimeline.Add(new TimelineEntry("End (local)", State.RangeEnd.ToString("ddd, MMM d HH:mm", CultureInfo.InvariantCulture), DescribeRelative(State.RangeEnd)));
        State.RangeTimeline.Add(new TimelineEntry("End (UTC)", State.RangeEnd.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture), ""));
        State.RangeTimeline.Add(new TimelineEntry("Precision span", precisionSpan, $"Rounded to {State.SelectedPrecision.ToLowerInvariant()}"));

        State.BreakdownDetails.Add(new BreakdownEntry("Span", DescribeSpanExact(span)));
        State.BreakdownDetails.Add(new BreakdownEntry("Midpoint", MidpointDescription()));
        State.BreakdownDetails.Add(new BreakdownEntry("Countdown", CountdownDescription(span)));
        State.BreakdownDetails.Add(new BreakdownEntry("Business span", DescribeBusinessSpan(businessDays)));
        State.BreakdownDetails.Add(new BreakdownEntry("ISO weeks", IsoWeekDescription()));
        State.BreakdownDetails.Add(new BreakdownEntry("Weekday coverage", WeekdayCoverageDescription()));
    }

    private string PrecisionSpan(TimeSpan span)
    {
        return State.SelectedPrecision switch
        {
            "Minutes" => span.TotalMinutes.ToString("0.##", CultureInfo.InvariantCulture) + " min",
            "Hours" => span.TotalHours.ToString("0.##", CultureInfo.InvariantCulture) + " h",
            "Days" => span.TotalDays.ToString("0.##", CultureInfo.InvariantCulture) + " d",
            _ => span.TotalSeconds.ToString("0", CultureInfo.InvariantCulture) + " s"
        };
    }

    private static int CountBusinessDays(DateTime start, DateTime end)
    {
        var total = 0;
        var current = start.Date;
        while (current < end.Date)
        {
            if (current.DayOfWeek is not DayOfWeek.Saturday and not DayOfWeek.Sunday)
            {
                total++;
            }

            current = current.AddDays(1);
        }

        return total;
    }

    private string DescribeSpanExact(TimeSpan span)
    {
        var components = new List<string>();
        if (span.Days != 0)
        {
            components.Add($"{span.Days} day{(Math.Abs(span.Days) == 1 ? string.Empty : "s")}");
        }

        if (span.Hours != 0)
        {
            components.Add($"{span.Hours} hour{(Math.Abs(span.Hours) == 1 ? string.Empty : "s")}");
        }

        if (span.Minutes != 0)
        {
            components.Add($"{span.Minutes} minute{(Math.Abs(span.Minutes) == 1 ? string.Empty : "s")}");
        }

        if (span.Seconds != 0 || components.Count == 0)
        {
            components.Add($"{span.Seconds} second{(Math.Abs(span.Seconds) == 1 ? string.Empty : "s")}");
        }

        return string.Join(", ", components);
    }

    private string MidpointDescription()
    {
        var midpoint = State.RangeStart + ((State.RangeEnd - State.RangeStart) / 2);
        return midpoint.ToString("ddd, MMM d yyyy HH:mm", CultureInfo.InvariantCulture) + $" ({DescribeRelative(midpoint)})";
    }

    private string CountdownDescription(TimeSpan span)
    {
        if (State.RangeEnd < DateTime.Now)
        {
            return "Interval completed.";
        }

        var remaining = State.RangeEnd - DateTime.Now;
        return $"{remaining.TotalHours:0.##} hours remaining";
    }

    private void ApplyOffset()
    {
        var result = State.OffsetBase
            .AddYears(State.OffsetInvert ? -State.OffsetYears : State.OffsetYears)
            .AddMonths(State.OffsetInvert ? -State.OffsetMonths : State.OffsetMonths)
            .AddDays(State.OffsetInvert ? -State.OffsetDays : State.OffsetDays)
            .AddHours(State.OffsetInvert ? -State.OffsetHours : State.OffsetHours)
            .AddMinutes(State.OffsetInvert ? -State.OffsetMinutes : State.OffsetMinutes);

        State.OffsetSummary = new OffsetSummary(
            result.ToString("ddd, MMM d HH:mm", CultureInfo.InvariantCulture),
            result.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture),
            DescribeRelative(result));
    }

    private void ResetOffset()
    {
        State.OffsetYears = State.OffsetMonths = State.OffsetDays = State.OffsetHours = State.OffsetMinutes = 0;
        State.OffsetInvert = false;
        ApplyOffset();
    }

    private void ApplyOffsetPreset(TimeSpan span)
    {
        State.OffsetYears = 0;
        State.OffsetMonths = 0;
        State.OffsetDays = span.Days;
        State.OffsetHours = span.Hours;
        State.OffsetMinutes = span.Minutes;
        State.OffsetInvert = span < TimeSpan.Zero;
        ApplyOffset();
    }

    private void SetRangeMessage(string message, MessageIntent intent)
    {
        State.RangeMessage = message;
        State.RangeMessageIntent = intent;
    }

    private static string DescribeRelative(DateTime moment)
    {
        var now = DateTime.Now;
        var delta = moment - now;
        var suffix = delta.TotalSeconds >= 0 ? "from now" : "ago";
        var magnitude = delta.Duration();

        string value;
        if (magnitude.TotalDays >= 1)
        {
            value = magnitude.TotalDays.ToString("0.#", CultureInfo.InvariantCulture) + " day" + (magnitude.TotalDays >= 2 ? "s" : string.Empty);
        }
        else if (magnitude.TotalHours >= 1)
        {
            value = magnitude.TotalHours.ToString("0.#", CultureInfo.InvariantCulture) + " hour" + (magnitude.TotalHours >= 2 ? "s" : string.Empty);
        }
        else if (magnitude.TotalMinutes >= 1)
        {
            value = magnitude.TotalMinutes.ToString("0.#", CultureInfo.InvariantCulture) + " min";
        }
        else
        {
            value = Math.Max(1, (int)magnitude.TotalSeconds) + " sec";
        }

        return $"{value} {suffix}";
    }

    private static string DescribeBusinessSpan(int businessDays)
    {
        return businessDays switch
        {
            <= 0 => "No weekdays in range",
            1 => "1 business day (Mon-Fri)",
            _ => $"{businessDays} business days (Mon-Fri)"
        };
    }

    private string IsoWeekDescription()
    {
        var startWeek = ISOWeek.GetWeekOfYear(State.RangeStart);
        var endWeek = ISOWeek.GetWeekOfYear(State.RangeEnd);
        var startYear = ISOWeek.GetYear(State.RangeStart);
        var endYear = ISOWeek.GetYear(State.RangeEnd);

        if (startWeek == endWeek && startYear == endYear)
        {
            return $"Week {startWeek} of {startYear}";
        }

        return $"Week {startWeek} {startYear} -> Week {endWeek} {endYear}";
    }

    private string WeekdayCoverageDescription()
    {
        var coverage = new bool[7];
        var cursor = State.RangeStart.Date;
        var end = State.RangeEnd.Date;

        while (cursor <= end)
        {
            coverage[(int)cursor.DayOfWeek] = true;
            cursor = cursor.AddDays(1);
        }

        var names = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
        var included = new List<string>();

        for (var i = 0; i < names.Length; i++)
        {
            if (coverage[i])
            {
                included.Add(names[i]);
            }
        }

        if (included.Count == names.Length)
        {
            return "All days";
        }

        if (included.Count == 0)
        {
            return "No days covered";
        }

        return string.Join(", ", included);
    }

    private sealed record MetricView(string Label, string Value, string Hint);
    private sealed record TimelineEntry(string Label, string Value, string Hint);
    private sealed record BreakdownEntry(string Label, string Description);
    private sealed record OffsetSummary(string ResultLocal, string ResultUtc, string RelativeText);

    private sealed class PageState
    {
        public DateTime RangeStart = DateTime.Now.AddDays(-1);
        public DateTime RangeEnd = DateTime.Now;
        public string SelectedPrecision = "Seconds";
        public DateTime OffsetBase = DateTime.Now;
        public int OffsetYears;
        public int OffsetMonths;
        public int OffsetDays;
        public int OffsetHours;
        public int OffsetMinutes;
        public bool OffsetInvert;
        public OffsetSummary? OffsetSummary;
        public string? RangeMessage;
        public MessageIntent RangeMessageIntent = MessageIntent.Info;
        public readonly List<MetricView> DurationMetrics = new();
        public readonly List<TimelineEntry> RangeTimeline = new();
        public readonly List<BreakdownEntry> BreakdownDetails = new();
    }
}
