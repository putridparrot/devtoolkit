@page "/base64-url"
@attribute [ToolPage("Base64/URL", "🔤", "Encode and decode Base64 and URL strings.", 5)]
@using DevToolkit.Services
@inject ToolStateStore Store
@using System.Text
@using DevToolkit.Infrastructure

<PageTitle>Base64/URL</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px; height: 100%;">
    <FluentLabel Typo="Typography.PageTitle">Base64 / URL Tools</FluentLabel>

    <FluentCard Style="padding: 20px;">
        <FluentTabs>
            <FluentTab Label="Base64">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 15px; padding: 20px;">
                    <FluentLabel Typo="Typography.Subject">Input</FluentLabel>
                    <FluentTextArea Value="@State.Base64Input"
                                    ValueChanged="@((string value) => State.Base64Input = value)"
                                    Rows="8"
                                    Style="width: 100%; font-family: monospace;" />

                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px;">
                        <FluentButton Appearance="Appearance.Accent" OnClick="EncodeBase64">Encode</FluentButton>
                        <FluentButton Appearance="Appearance.Outline" OnClick="DecodeBase64">Decode</FluentButton>
                        <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearBase64">Clear</FluentButton>
                    </FluentStack>

                    @if (!string.IsNullOrWhiteSpace(State.Base64Error))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error">@State.Base64Error</FluentMessageBar>
                    }

                    <FluentLabel Typo="Typography.Subject">Output</FluentLabel>
                    <FluentTextArea Value="@State.Base64Output"
                                    ValueChanged="@((string value) => State.Base64Output = value)"
                                    Rows="8"
                                    Style="width: 100%; font-family: monospace;" />
                </FluentStack>
            </FluentTab>

            <FluentTab Label="URL">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 15px; padding: 20px;">
                    <FluentLabel Typo="Typography.Subject">Input</FluentLabel>
                    <FluentTextArea Value="@State.UrlInput"
                                    ValueChanged="@((string value) => State.UrlInput = value)"
                                    Rows="8"
                                    Style="width: 100%; font-family: monospace;" />

                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px;">
                        <FluentButton Appearance="Appearance.Accent" OnClick="EncodeUrl">Encode</FluentButton>
                        <FluentButton Appearance="Appearance.Outline" OnClick="DecodeUrl">Decode</FluentButton>
                        <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearUrl">Clear</FluentButton>
                    </FluentStack>

                    @if (!string.IsNullOrWhiteSpace(State.UrlError))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error">@State.UrlError</FluentMessageBar>
                    }

                    <FluentLabel Typo="Typography.Subject">Output</FluentLabel>
                    <FluentTextArea Value="@State.UrlOutput"
                                    ValueChanged="@((string value) => State.UrlOutput = value)"
                                    Rows="8"
                                    Style="width: 100%; font-family: monospace;" />
                </FluentStack>
            </FluentTab>
        </FluentTabs>
    </FluentCard>
</FluentStack>
</div>

@code {
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out _);
    }

    private void EncodeBase64()
    {
        State.Base64Error = string.Empty;
        try
        {
            var bytes = Encoding.UTF8.GetBytes(State.Base64Input);
            State.Base64Output = Convert.ToBase64String(bytes);
        }
        catch (Exception ex)
        {
            State.Base64Error = $"Error encoding Base64: {ex.Message}";
        }
    }

    private void DecodeBase64()
    {
        State.Base64Error = string.Empty;
        try
        {
            var bytes = Convert.FromBase64String(State.Base64Input.Trim());
            State.Base64Output = Encoding.UTF8.GetString(bytes);
        }
        catch (Exception ex)
        {
            State.Base64Error = $"Error decoding Base64: {ex.Message}";
        }
    }

    private void EncodeUrl()
    {
        State.UrlError = string.Empty;
        try
        {
            State.UrlOutput = Uri.EscapeDataString(State.UrlInput);
        }
        catch (Exception ex)
        {
            State.UrlError = $"Error encoding URL: {ex.Message}";
        }
    }

    private void DecodeUrl()
    {
        State.UrlError = string.Empty;
        try
        {
            State.UrlOutput = Uri.UnescapeDataString(State.UrlInput);
        }
        catch (Exception ex)
        {
            State.UrlError = $"Error decoding URL: {ex.Message}";
        }
    }

    private void ClearBase64()
    {
        State.Base64Input = string.Empty;
        State.Base64Output = string.Empty;
        State.Base64Error = string.Empty;
    }

    private void ClearUrl()
    {
        State.UrlInput = string.Empty;
        State.UrlOutput = string.Empty;
        State.UrlError = string.Empty;
    }

    private sealed class PageState
    {
        public string Base64Input = string.Empty;
        public string Base64Output = string.Empty;
        public string Base64Error = string.Empty;
        public string UrlInput = string.Empty;
        public string UrlOutput = string.Empty;
        public string UrlError = string.Empty;
    }
}
