@page "/regex"
@attribute [ToolPage("Regex", "🔎", "Test regex patterns with options and inspect match groups.", 11)]
@using DevToolkit.Services
@inject ToolStateStore Store
@using System.Text.RegularExpressions
@using DevToolkit.Infrastructure

<PageTitle>Regex Tester</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px; height: 100%;">
    <FluentLabel Typo="Typography.PageTitle">Regex Tester</FluentLabel>

    <FluentCard Style="padding: 20px;">
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
            <FluentLabel Typo="Typography.Subject">Pattern</FluentLabel>
            <FluentTextField Value="@State.Pattern"
                             ValueChanged="@((string v) => State.Pattern = v)"
                             Placeholder="e.g. ^\\d{4}-\\d{2}-\\d{2}$"
                             Style="width: 100%;" />

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 16px; flex-wrap: wrap;">
                <FluentCheckbox @bind-Value="State.IgnoreCase" Label="Ignore Case" />
                <FluentCheckbox @bind-Value="State.Multiline" Label="Multiline" />
                <FluentCheckbox @bind-Value="State.Singleline" Label="Singleline" />
            </FluentStack>

            <FluentLabel Typo="Typography.Subject">Input Text</FluentLabel>
            <FluentTextArea Value="@State.InputText"
                            ValueChanged="@((string v) => State.InputText = v)"
                            Rows="10"
                            Style="width: 100%; font-family: monospace;" />

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px;">
                <FluentButton Appearance="Appearance.Accent" OnClick="RunRegex">Run</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="ClearAll">Clear</FluentButton>
            </FluentStack>

            @if (!string.IsNullOrWhiteSpace(State.ErrorMessage))
            {
                <FluentMessageBar Intent="MessageIntent.Error">@State.ErrorMessage</FluentMessageBar>
            }
        </FluentStack>
    </FluentCard>

    <FluentCard Style="padding: 20px;">
        <FluentLabel Typo="Typography.Subject">Matches (@State.Results.Count)</FluentLabel>

        @if (State.Results.Any())
        {
            <FluentDataGrid Items="@State.Results.AsQueryable()" GridTemplateColumns="80px 100px 120px 1fr" Style="margin-top: 10px;">
                <PropertyColumn Property="@(m => m.Index)" Title="#" />
                <PropertyColumn Property="@(m => m.Start)" Title="Start" />
                <PropertyColumn Property="@(m => m.Length)" Title="Length" />
                <PropertyColumn Property="@(m => m.Value)" Title="Value" />
            </FluentDataGrid>

            <FluentLabel Typo="Typography.Subject" Style="margin-top: 15px;">Groups</FluentLabel>
            <FluentDataGrid Items="@State.Groups.AsQueryable()" GridTemplateColumns="80px 80px 100px 120px 1fr" Style="margin-top: 10px;">
                <PropertyColumn Property="@(g => g.MatchIndex)" Title="Match" />
                <PropertyColumn Property="@(g => g.GroupIndex)" Title="Group" />
                <PropertyColumn Property="@(g => g.GroupName)" Title="Name" />
                <PropertyColumn Property="@(g => g.Start)" Title="Start" />
                <PropertyColumn Property="@(g => g.Value)" Title="Value" />
            </FluentDataGrid>
        }
        else if (State.RanOnce)
        {
            <FluentLabel Style="margin-top: 10px;">No matches found.</FluentLabel>
        }
    </FluentCard>
</FluentStack>
</div>

@code {
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out _);
    }

    private void RunRegex()
    {
        State.ErrorMessage = string.Empty;
        State.Results.Clear();
        State.Groups.Clear();
        State.RanOnce = true;

        try
        {
            if (string.IsNullOrWhiteSpace(State.Pattern))
            {
                State.ErrorMessage = "Pattern is required.";
                return;
            }

            var options = global::System.Text.RegularExpressions.RegexOptions.None;
            if (State.IgnoreCase) options |= global::System.Text.RegularExpressions.RegexOptions.IgnoreCase;
            if (State.Multiline) options |= global::System.Text.RegularExpressions.RegexOptions.Multiline;
            if (State.Singleline) options |= global::System.Text.RegularExpressions.RegexOptions.Singleline;

            var regex = new global::System.Text.RegularExpressions.Regex(State.Pattern, options);
            var matches = regex.Matches(State.InputText);

            for (var i = 0; i < matches.Count; i++)
            {
                var m = matches[i];
                State.Results.Add(new RegexMatchRow
                {
                    Index = i + 1,
                    Start = m.Index,
                    Length = m.Length,
                    Value = m.Value
                });

                for (var gi = 0; gi < m.Groups.Count; gi++)
                {
                    var group = m.Groups[gi];
                    State.Groups.Add(new RegexGroupRow
                    {
                        MatchIndex = i + 1,
                        GroupIndex = gi,
                        GroupName = regex.GroupNameFromNumber(gi),
                        Start = group.Index,
                        Value = group.Value
                    });
                }
            }
        }
        catch (Exception ex)
        {
            State.ErrorMessage = $"Regex error: {ex.Message}";
        }
    }

    private void ClearAll()
    {
        State.Pattern = string.Empty;
        State.InputText = string.Empty;
        State.IgnoreCase = false;
        State.Multiline = false;
        State.Singleline = false;
        State.ErrorMessage = string.Empty;
        State.RanOnce = false;
        State.Results.Clear();
        State.Groups.Clear();
    }

    private class RegexMatchRow
    {
        public int Index { get; set; }
        public int Start { get; set; }
        public int Length { get; set; }
        public string Value { get; set; } = string.Empty;
    }

    private class RegexGroupRow
    {
        public int MatchIndex { get; set; }
        public int GroupIndex { get; set; }
        public string GroupName { get; set; } = string.Empty;
        public int Start { get; set; }
        public string Value { get; set; } = string.Empty;
    }

    private sealed class PageState
    {
        public string Pattern = string.Empty;
        public string InputText = string.Empty;
        public bool IgnoreCase;
        public bool Multiline;
        public bool Singleline;
        public string ErrorMessage = string.Empty;
        public bool RanOnce;
        public List<RegexMatchRow> Results = new();
        public List<RegexGroupRow> Groups = new();
    }
}
