@page "/guid"
@using DevToolkit.Infrastructure
@inject IJSRuntime JSRuntime
@attribute [ToolPage("GUID/UUID", "🧬", "Generate GUIDs in multiple formats including bulk generation.", 8)]
@using DevToolkit.Services
@inject ToolStateStore Store

<PageTitle>GUID/UUID</PageTitle>

<div class="page-container">
<FluentStack Orientation="Orientation.Vertical" Style="gap: 20px; height: 100%;">
    <FluentLabel Typo="Typography.PageTitle">GUID / UUID Tools</FluentLabel>

        <FluentCard Style="padding: 20px;">
            <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
                <FluentLabel Typo="Typography.Subject">Generate Single GUID</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; flex-wrap: wrap;">
                    <FluentButton Appearance="Appearance.Accent" OnClick="GenerateSingle">Generate</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" OnClick="ClearSingle">Clear</FluentButton>
                </FluentStack>

                <FluentLabel Style="display: flex; align-items: center; gap: 6px;">
                    <span><strong>D</strong> (default): @State.SingleGuidD</span>
                    @if (HasGuidValue(State.SingleGuidD))
                    {
                        <FluentButton Appearance="Appearance.Stealth" Style="padding: 2px;" OnClick="() => CopyToClipboard(State.SingleGuidD)">
                            <FluentIcon Icon="Icons.Regular.Size20.Copy" />
                        </FluentButton>
                    }
                </FluentLabel>
                <FluentLabel Style="display: flex; align-items: center; gap: 6px;">
                    <span><strong>N</strong> (digits): @State.SingleGuidN</span>
                    @if (HasGuidValue(State.SingleGuidN))
                    {
                        <FluentButton Appearance="Appearance.Stealth" Style="padding: 2px;" OnClick="() => CopyToClipboard(State.SingleGuidN)">
                            <FluentIcon Icon="Icons.Regular.Size20.Copy" />
                        </FluentButton>
                    }
                </FluentLabel>
                <FluentLabel Style="display: flex; align-items: center; gap: 6px;">
                    <span><strong>B</strong> (braces): @State.SingleGuidB</span>
                    @if (HasGuidValue(State.SingleGuidB))
                    {
                        <FluentButton Appearance="Appearance.Stealth" Style="padding: 2px;" OnClick="() => CopyToClipboard(State.SingleGuidB)">
                            <FluentIcon Icon="Icons.Regular.Size20.Copy" />
                        </FluentButton>
                    }
                </FluentLabel>
                <FluentLabel Style="display: flex; align-items: center; gap: 6px;">
                    <span><strong>P</strong> (parentheses): @State.SingleGuidP</span>
                    @if (HasGuidValue(State.SingleGuidP))
                    {
                        <FluentButton Appearance="Appearance.Stealth" Style="padding: 2px;" OnClick="() => CopyToClipboard(State.SingleGuidP)">
                            <FluentIcon Icon="Icons.Regular.Size20.Copy" />
                        </FluentButton>
                    }
                </FluentLabel>
            </FluentStack>
        </FluentCard>

    <FluentCard Style="padding: 20px;">
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
            <FluentLabel Typo="Typography.Subject">Bulk Generate</FluentLabel>

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; align-items: center; overflow: visible;">
                <FluentLabel>Count</FluentLabel>
                <FluentNumberField Value="@State.BulkCount" ValueChanged="@((int? v) => State.BulkCount = v ?? 10)" Min="1" Max="500" Step="1" Style="width: 120px;" />
                <FluentLabel>Format</FluentLabel>
                <FluentCombobox Items="@_formats" @bind-SelectedOption="State.SelectedFormat" Style="width: 140px;" Class="readonly-combo">
                    <OptionTemplate>@context</OptionTemplate>
                </FluentCombobox>
            </FluentStack>

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 10px; flex-wrap: wrap;">
                <FluentButton Appearance="Appearance.Accent" OnClick="GenerateBulk">Generate List</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="ClearBulk">Clear</FluentButton>
            </FluentStack>

            <FluentTextArea Value="@State.BulkOutput" ValueChanged="@((string v) => State.BulkOutput = v)" Rows="12" Style="width: 100%; font-family: monospace;" Placeholder="Generated GUID list appears here..." />
        </FluentStack>
    </FluentCard>
</FluentStack>
</div>

@code {
    private PageState State = null!;

    protected override void OnInitialized()
    {
        State = Store.Get<PageState>(out _);
    }

    private readonly List<string> _formats = new() { "D", "N", "B", "P" };

    private void GenerateSingle()
    {
        var guid = global::System.Guid.NewGuid();
        State.SingleGuidD = guid.ToString("D");
        State.SingleGuidN = guid.ToString("N");
        State.SingleGuidB = guid.ToString("B");
        State.SingleGuidP = guid.ToString("P");
    }

    private void ClearSingle()
    {
        State.SingleGuidD = "-";
        State.SingleGuidN = "-";
        State.SingleGuidB = "-";
        State.SingleGuidP = "-";
    }

    private void GenerateBulk()
    {
        var format = string.IsNullOrWhiteSpace(State.SelectedFormat) ? "D" : State.SelectedFormat;
        var lines = new List<string>(State.BulkCount);

        for (var i = 0; i < State.BulkCount; i++)
        {
            lines.Add(global::System.Guid.NewGuid().ToString(format));
        }

        State.BulkOutput = string.Join(Environment.NewLine, lines);
    }

    private void ClearBulk()
    {
        State.BulkOutput = string.Empty;
    }

    private async Task CopyToClipboard(string value)
    {
        if (!string.IsNullOrEmpty(value) && JSRuntime is not null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value);
        }
    }

    private static bool HasGuidValue(string value)
    {
        return !string.IsNullOrWhiteSpace(value) && !string.Equals(value, "-", StringComparison.Ordinal);
    }

    private sealed class PageState
    {
        public string SingleGuidD = "-";
        public string SingleGuidN = "-";
        public string SingleGuidB = "-";
        public string SingleGuidP = "-";
        public int BulkCount = 10;
        public string SelectedFormat = "D";
        public string BulkOutput = string.Empty;
    }
}

<style>
    .overlay-select .fluent-select__listbox,
    .readonly-combo .fluent-combobox__listbox {
        top: 100% !important;
        bottom: auto !important;
    }

    /* Visual cue that the combo behaves like a select */
    .readonly-combo::part(control) input {
        caret-color: transparent;
    }

</style>
